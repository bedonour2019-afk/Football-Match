    <script>
        function showToast(msg) {
            const t = document.getElementById('toastMsg');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }

        async function assignPlayer() {
            const pid = document.getElementById('playerSelect').value;
            const team = document.getElementById('teamSelect').value;
            const pos = document.getElementById('positionSelect').value;
            if (!pid) { showToast('ط§ط®طھط§ط± ظ„ط§ط¹ط¨ ط£ظˆظ„ط§ظ‹'); return; }

            const res = await fetch('/Teams/SetTeam', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attendanceId: parseInt(pid), teamNumber: parseInt(team), position: pos })
            });
            const d = await res.json();
            if (d.success) { showToast('طھظ… ط¥ط¶ط§ظپط© ط§ظ„ظ„ط§ط¹ط¨ ظ„ظ„ظپط±ظٹظ‚ âœ…'); setTimeout(() => location.reload(), 800); }
            else showToast(d.message || 'ط­طµظ„ ط®ط·ط£');
        }

        async function setRating() {
            const pid = document.getElementById('ratingPlayerSelect').value;
            const rating = parseInt(document.getElementById('ratingValue').value);
            if (!pid || isNaN(rating)) { showToast('ط§ط®طھط§ط± ظ„ط§ط¹ط¨ ظˆط­ط· ط§ظ„طھظ‚ظٹظٹظ…'); return; }

            const res = await fetch('/Teams/SetRating', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attendanceId: parseInt(pid), rating })
            });
            const d = await res.json();
            if (d.success) { showToast(`طھظ… ط­ظپط¸ ط§ظ„طھظ‚ظٹظٹظ… ${d.rating} â­گ`); setTimeout(() => location.reload(), 800); }
            else showToast(d.message || 'ط­طµظ„ ط®ط·ط£');
        }

        async function setTag() {
            const pid = document.getElementById('tagPlayerSelect').value;
            const tag = document.getElementById('tagValue').value.trim();
            if (!pid) { showToast('ط§ط®طھط§ط± ظ„ط§ط¹ط¨ ط£ظˆظ„ط§ظ‹'); return; }

            const res = await fetch('/Teams/SetTag', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attendanceId: parseInt(pid), tag })
            });
            const d = await res.json();
            if (d.success) { showToast('طھظ… ط­ظپط¸ ط§ظ„طھط§ط¬ âœ…'); setTimeout(() => location.reload(), 800); }
            else showToast(d.message || 'ط­طµظ„ ط®ط·ط£');
        }

        async function setWinner(teamNum) {
            const res = await fetch('/Teams/SetWinner', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ teamNumber: teamNum })
            });
            const d = await res.json();
