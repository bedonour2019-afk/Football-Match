    int currentId = ViewBag.CurrentAttendanceId ?? 0;
    bool isAdminUser = ViewBag.IsAdmin ?? false;
    int? winnerTeam = ViewBag.WinnerTeam;

    var team1 = Model.Where(a => a.TeamNumber == 1).ToList();
    var team2 = Model.Where(a => a.TeamNumber == 2).ToList();
    var unassigned = Model.Where(a => a.TeamNumber == null).ToList();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>âڑ½ طµظپط­ط© ط§ظ„ظپط±ظ‚</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0d0d1a;
            color: #fff;
            font-family: "Segoe UI", Tahoma, sans-serif;
            min-height: 100vh;
            padding-bottom: 40px;
        }

        .page-header {
            background: rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 10;
            backdrop-filter: blur(10px);
        }

        .page-title {
            font-size: 1.15rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .back-btn {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            color: rgba(255,255,255,0.85);
            padding: 7px 14px;
            font-size: 0.82rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .back-btn:hover { color: #fff; background: rgba(255,255,255,0.14); }

        .container { max-width: 900px; margin: 0 auto; padding: 20px 16px; }

        /* Teams Grid */
        .teams-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        @@media (max-width: 640px) {
            .teams-grid { grid-template-columns: 1fr; }
        }

        .team-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 20px;
            transition: all 0.3s;
        }

        .team-card.winner {
            background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(234,179,8,0.08));
            border-color: rgba(245,158,11,0.5);
            box-shadow: 0 0 30px rgba(245,158,11,0.15);
        }

        .team-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .team-name {
            font-size: 1.1rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .team-1-color { color: #3b82f6; }
        .team-2-color { color: #ef4444; }

        .winner-badge {
            background: linear-gradient(135deg, #f59e0b, #eab308);
            color: #000;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.72rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .player-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 12px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            margin-bottom: 8px;
            transition: all 0.2s;
        }

        .player-card.mvp-player {
            background: linear-gradient(90deg, rgba(245,158,11,0.15), rgba(255,255,255,0.04));
            border-color: rgba(245,158,11,0.3);
        }

        .player-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .player-avatar-ph {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .player-info { flex: 1; min-width: 0; }

        .player-name {
            font-size: 0.88rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .player-sub {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.45);
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .position-badge {
            background: rgba(124,58,237,0.2);
            color: #a855f7;
            border: 1px solid rgba(124,58,237,0.3);
            border-radius: 6px;
            padding: 1px 6px;
            font-size: 0.68rem;
            font-weight: 700;
        }

        .tag-badge {
            background: rgba(245,158,11,0.15);
            color: #f59e0b;
            border: 1px solid rgba(245,158,11,0.3);
            border-radius: 6px;
            padding: 1px 6px;
            font-size: 0.68rem;
            font-weight: 700;
        }

        /* Rating Stars */
        .rating-display {
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .rating-num {
            font-size: 0.78rem;
            font-weight: 800;
            color: #f59e0b;
            min-width: 20px;
        }

        /* Admin Controls */
        .admin-panel {
            background: rgba(124,58,237,0.08);
            border: 1px solid rgba(124,58,237,0.2);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 24px;
        }

        .admin-panel-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #a855f7;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .admin-form-row {
            display: flex;
            gap: 8px;
            align-items: flex-end;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .admin-select, .admin-input {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            color: #fff;
            padding: 7px 10px;
            font-size: 0.82rem;
            min-width: 100px;
        }

        .admin-btn {
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            border: none;
            border-radius: 8px;
            color: #fff;
            padding: 7px 14px;
            font-size: 0.82rem;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }

        .admin-btn:hover { transform: scale(1.03); }

        .admin-btn.danger {
            background: linear-gradient(135deg, #ef4444, #f87171);
        }

        .admin-btn.gold {
            background: linear-gradient(135deg, #f59e0b, #eab308);
            color: #000;
        }

        /* Unassigned Players */
        .unassigned-section {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 16px;
        }

        .unassigned-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: rgba(255,255,255,0.45);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        /* Toast */
        .toast-msg {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(124,58,237,0.9);
            color: #fff;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
            z-index: 9999;
        }

        .toast-msg.show { opacity: 1; }

        /* Profile click */
        .player-card { cursor: pointer; }
        .player-card:hover { background: rgba(255,255,255,0.07); }
    </style>
</head>
<body>
