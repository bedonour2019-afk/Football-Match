@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>⚽ Match Registration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            width: 100%; height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: url('/assets/frutiger_aero_bg.jpg') no-repeat center center / cover fixed;
            color: #fff;
            overflow: hidden;
        }

        /* ───── BUBBLES ───── */
        .bubbles {
            position: fixed; inset: 0;
            pointer-events: none; overflow: hidden; z-index: 1;
        }
        .bbl {
            position: absolute; bottom: -80px; border-radius: 50%;
            background: radial-gradient(circle at 30% 28%,
                rgba(255,255,255,0.95) 0%,
                rgba(186,230,253,0.55) 40%,
                rgba(56,189,248,0.1)  80%, transparent 100%);
            border: 1px solid rgba(255,255,255,0.65);
            box-shadow: inset 0 0 8px rgba(255,255,255,0.55);
            animation: riseUp linear infinite;
        }
        .bbl:nth-child(1){left:4%;  width:36px; height:36px; animation-duration:19s; animation-delay:0s;}
        .bbl:nth-child(2){left:17%; width:60px; height:60px; animation-duration:25s; animation-delay:4s;}
        .bbl:nth-child(3){left:38%; width:26px; height:26px; animation-duration:17s; animation-delay:2s;}
        .bbl:nth-child(4){left:60%; width:50px; height:50px; animation-duration:22s; animation-delay:6s;}
        .bbl:nth-child(5){left:78%; width:40px; height:40px; animation-duration:16s; animation-delay:1s;}
        .bbl:nth-child(6){left:91%; width:65px; height:65px; animation-duration:28s; animation-delay:9s;}

        @@keyframes riseUp {
            0%  { transform:translateY(0)      scale(0.8); opacity:0; }
            8%  { opacity:0.85; }
            90% { opacity:0.75; }
            100%{ transform:translateY(-105vh) scale(1.2); opacity:0; }
        }

        /* ───── STAGE ───── */
        .stage {
            position: relative; z-index: 10;
            width: 100%; height: 100%;
            display: flex; flex-direction: column;
            padding: 10px 12px 8px;
            gap: 10px;
        }

        /* Top row: Weather + Music */
        .top-row {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        /* Center row: Clock + Login */
        .center-row {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            justify-content: center;
            flex: 1;
            min-height: 0;
        }

        /* ───── GLASS PANEL ───── */
        .gp {
            background: rgba(255,255,255,0.10);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border: 1px solid rgba(255,255,255,0.60);
            border-radius: 18px;
            box-shadow:
                0 6px 28px rgba(0,50,120,0.15),
                inset 0 1.5px 0 rgba(255,255,255,0.80),
                inset 0 -1px 0 rgba(255,255,255,0.10);
            position: relative;
            overflow: hidden;
        }
        /* specular top-curve highlight */
        .gp::before {
            content:'';
            position:absolute; top:0; left:0; right:0; height:40%;
            background: linear-gradient(180deg,
                rgba(255,255,255,0.38) 0%,
                rgba(255,255,255,0.05) 75%,
                transparent 100%);
            border-radius: 18px 18px 55% 55% / 18px 18px 18% 18%;
            pointer-events:none; z-index:2;
        }

        /* window title bar */
        .bar {
            display:flex; justify-content:space-between; align-items:center;
            padding:6px 13px;
            border-bottom:1px solid rgba(255,255,255,0.20);
            font-size:0.76rem; font-weight:700;
            color:rgba(255,255,255,0.95);
            text-shadow:0 1px 3px rgba(0,30,80,0.5);
            user-select:none; position:relative; z-index:3;
        }
        .bar-left { display:flex; align-items:center; gap:6px; }
        .wbts { display:flex; gap:4px; }
        .wb {
            width:14px; height:14px; border-radius:3px;
            border:1px solid rgba(255,255,255,0.5);
            background:rgba(255,255,255,0.2);
            display:inline-flex; align-items:center; justify-content:center;
            font-size:0.5rem; color:#fff; cursor:pointer;
        }
        .wb:hover { background:rgba(255,255,255,0.55); }
        .wb.x:hover { background:#ef4444; }

        /* ───── WEATHER ───── */
        .weather { flex:1; min-width:0; }
        .w-body { padding:10px 14px 12px; position:relative; z-index:3; }
        .w-main { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
        .sun {
            width:42px; height:42px; border-radius:50%; flex-shrink:0;
            background: radial-gradient(circle at 35% 35%, #fff9c4, #ffd43b 55%, #f59f00);
            box-shadow: 0 0 18px rgba(255,210,0,0.8);
            display:flex; align-items:center; justify-content:center;
            font-size:1.2rem;
        }
        .w-temp { font-size:2rem; font-weight:800; text-shadow:0 2px 5px rgba(0,30,80,0.5); }
        .w-desc { font-size:0.82rem; font-weight:700; color:#e0f2fe; }
        .w-feels { font-size:0.68rem; color:rgba(224,242,254,0.8); }
        .forecast {
            display:flex; justify-content:space-between;
            background:rgba(255,255,255,0.10);
            border:1px solid rgba(255,255,255,0.25);
            border-radius:10px; padding:7px 10px;
            font-size:0.65rem; font-weight:700; color:#fff;
        }
        .fc { display:flex; flex-direction:column; align-items:center; gap:2px; }
        .fcs { color:#fcc419; font-size:0.78rem; }

        /* ───── MUSIC ───── */
        .music { flex:1.3; min-width:0; }
        .m-body { padding:10px 14px; position:relative; z-index:3; }
        .m-meta { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
        .album {
            width:52px; height:52px; border-radius:10px;
            object-fit:cover; border:1.5px solid rgba(255,255,255,0.65);
            box-shadow:0 3px 12px rgba(0,50,120,0.25); flex-shrink:0;
        }
        .t-name { font-size:0.88rem; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1px 3px rgba(0,30,80,0.6); }
        .t-artist { font-size:0.72rem; font-weight:600; color:#bae6fd; }
        .t-album  { font-size:0.64rem; color:rgba(224,242,254,0.75); }
        .scrub-wrap { margin-bottom:9px; }
        .scrub {
            width:100%; height:5px; -webkit-appearance:none; appearance:none;
            background:rgba(255,255,255,0.28); border-radius:3px;
            outline:none; cursor:pointer;
        }
        .scrub::-webkit-slider-thumb {
            -webkit-appearance:none; width:14px; height:14px;
            border-radius:50%; background:#38bdf8;
            border:2px solid #fff; box-shadow:0 0 8px rgba(56,189,248,0.9);
            cursor:pointer;
        }
        .t-labels {
            display:flex; justify-content:space-between;
            font-size:0.65rem; font-weight:700; color:#fff;
            margin-top:3px; font-family:Consolas,monospace;
        }
        .m-ctrl { display:flex; align-items:center; justify-content:space-between; padding:0 4px; }
        .cbtn {
            background:none; border:none; color:#fff;
            font-size:0.88rem; cursor:pointer; padding:4px;
            transition:all 0.15s; text-shadow:0 1px 3px rgba(0,30,80,0.5);
        }
        .cbtn:hover { color:#38bdf8; transform:scale(1.15); }
        .play-btn {
            width:36px; height:36px; border-radius:50%;
            background:radial-gradient(circle at 35% 35%, #7dd3fc, #0284c7 60%, #0369a1);
            border:2px solid rgba(255,255,255,0.9);
            box-shadow:0 0 14px rgba(2,132,199,0.7), inset 0 1px 0 rgba(255,255,255,0.75);
            color:#fff; display:flex; align-items:center; justify-content:center;
            font-size:0.9rem; cursor:pointer; transition:all 0.2s;
        }
        .play-btn:hover { transform:scale(1.1); box-shadow:0 0 22px rgba(2,132,199,0.9); }

        /* ───── CLOCK ───── */
        .clock-panel {
            width:150px; flex-shrink:0;
            text-align:center;
            padding:16px 12px;
            display:none;
        }
        @@media (min-width:900px) { .clock-panel { display:block; } }
        .globe { font-size:2.2rem; color:#38bdf8; filter:drop-shadow(0 0 10px rgba(56,189,248,0.8)); margin-bottom:7px; }
        .ck-time { font-size:1.25rem; font-weight:800; text-shadow:0 1px 4px rgba(0,30,80,0.6); }
        .ck-date { font-size:0.67rem; color:rgba(224,242,254,0.88); font-weight:600; margin-top:3px; }
        .eco {
            margin-top:9px; font-size:0.62rem; color:#a7f3d0; font-weight:700;
            display:flex; align-items:center; justify-content:center; gap:3px;
            background:rgba(16,185,129,0.18);
            border:1px solid rgba(16,185,129,0.32);
            border-radius:7px; padding:3px 6px;
        }

        /* ───── LOGIN CARD ───── */
        .login-card {
            width:100%; max-width:400px;
            display:flex; flex-direction:column;
            overflow: hidden;
        }
        .login-body {
            padding:18px 24px 16px;
            text-align:center;
            position:relative; z-index:3;
            overflow-y: auto;
            flex: 1;
        }
        /* hide scrollbar visually */
        .login-body::-webkit-scrollbar { display:none; }

        .avatar {
            width:76px; height:76px; border-radius:50%;
            margin:0 auto 10px;
            background:radial-gradient(circle at 38% 32%,
                rgba(255,255,255,0.9) 0%,
                rgba(147,210,255,0.65) 55%,
                rgba(2,132,199,0.7) 100%);
            border:2.5px solid rgba(255,255,255,0.88);
            box-shadow:0 0 24px rgba(56,189,248,0.5), inset 0 2px 4px rgba(255,255,255,0.85);
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; overflow:hidden; transition:all 0.25s;
        }
        .avatar:hover { transform:scale(1.05); }
        .avatar i { font-size:2.4rem; color:#0369a1; }
        .avatar img { width:100%; height:100%; object-fit:cover; }

        .login-title { font-size:1.7rem; font-weight:800; text-shadow:0 2px 5px rgba(0,30,80,0.6); margin-bottom:2px; }
        .login-sub   { font-size:0.82rem; color:rgba(224,242,254,0.9); font-weight:600; margin-bottom:16px; }

        .err-box {
            background:rgba(239,68,68,0.22);
            border:1px solid rgba(239,68,68,0.6);
            border-radius:10px; padding:8px 11px;
            margin-bottom:12px; font-size:0.8rem;
            font-weight:700; color:#fff; text-align:left;
        }

        /* Fields */
        .fw { position:relative; margin-bottom:9px; text-align:left; }
        .fi {
            position:absolute; left:12px; top:50%; transform:translateY(-50%);
            color:#0284c7; font-size:0.86rem; pointer-events:none; z-index:1;
        }
        .gf {
            width:100%;
            background:rgba(255,255,255,0.52);
            backdrop-filter:blur(6px);
            border:1.5px solid rgba(255,255,255,0.70);
            border-radius:11px;
            padding:10px 40px 10px 38px;
            font-size:0.9rem; font-weight:600;
            color:#034574; outline:none;
            transition:all 0.2s;
            box-shadow:inset 0 1px 3px rgba(0,50,120,0.08);
        }
        .gf::placeholder { color:rgba(3,69,116,0.5); font-weight:500; }
        .gf:focus {
            background:rgba(255,255,255,0.70);
            border-color:#38bdf8;
            box-shadow:0 0 0 3px rgba(56,189,248,0.28);
        }
        .eye {
            position:absolute; right:11px; top:50%; transform:translateY(-50%);
            background:none; border:none; color:#0284c7;
            cursor:pointer; font-size:0.88rem; padding:4px;
        }

        /* Sign In button */
        .signin {
            width:100%; padding:12px 18px;
            background:linear-gradient(180deg, #7dd3fc 0%, #38bdf8 38%, #0ea5e9 52%, #0284c7 100%);
            border:2px solid rgba(255,255,255,0.88);
            border-radius:28px; color:#fff;
            font-size:1.05rem; font-weight:800;
            cursor:pointer; margin-top:6px;
            display:flex; align-items:center; justify-content:center; gap:12px;
            box-shadow:0 7px 22px rgba(2,132,199,0.5), inset 0 1px 0 rgba(255,255,255,0.82);
            text-shadow:0 1px 2px rgba(0,30,80,0.7);
            transition:all 0.22s; letter-spacing:0.4px;
        }
        .signin:hover {
            background:linear-gradient(180deg, #bae6fd 0%, #7dd3fc 38%, #38bdf8 52%, #0284c7 100%);
            transform:translateY(-2px); box-shadow:0 12px 28px rgba(2,132,199,0.7);
        }
        .arr {
            width:26px; height:26px; border-radius:50%;
            background:rgba(255,255,255,0.25);
            border:1.5px solid rgba(255,255,255,0.75);
            display:flex; align-items:center; justify-content:center;
            font-size:0.82rem;
        }

        /* Footer */
        .login-foot {
            display:flex; justify-content:space-between; align-items:center;
            margin-top:12px; font-size:0.76rem; font-weight:700; color:#fff;
        }
        .login-foot label { display:flex; align-items:center; gap:5px; cursor:pointer; }
        .login-foot a { color:rgba(255,255,255,0.85); text-decoration:none; }
        .login-foot a:hover { text-decoration:underline; }

        /* Bottom taskbar */
        .taskbar {
            display:flex; justify-content:center; gap:28px;
            padding-top:14px; margin-top:12px;
            border-top:1px solid rgba(255,255,255,0.20);
        }
        .ti {
            display:flex; flex-direction:column; align-items:center; gap:3px;
            font-size:0.68rem; font-weight:700;
            color:rgba(255,255,255,0.88); text-decoration:none; cursor:pointer;
            transition:all 0.2s;
        }
        .ti:hover { color:#fff; transform:translateY(-2px); }
        .ti i { font-size:1.1rem; }

        /* Autoplay toast */
        .toast {
            position:fixed; bottom:20px; right:20px;
            background:rgba(255,255,255,0.18);
            backdrop-filter:blur(18px);
            border:1.5px solid rgba(255,255,255,0.70);
            border-radius:14px; padding:10px 18px;
            display:flex; align-items:center; gap:10px;
            font-size:0.84rem; font-weight:700; color:#fff;
            cursor:pointer; z-index:999;
            box-shadow:0 8px 26px rgba(0,50,130,0.28);
            animation:toastIn 0.5s cubic-bezier(0.34,1.56,0.64,1);
        }
        @@keyframes toastIn {
            from { transform:translateY(46px); opacity:0; }
            to   { transform:translateY(0);    opacity:1; }
        }

        /* ── Mobile tweaks ── */
        @@media (max-width:899px) {
            .stage { padding:8px 9px 6px; gap:8px; }
            .top-row { gap:8px; }
            .center-row { gap:8px; }
            .login-card { max-width:100%; }
        }

        @@media (max-width:480px) {
            .login-title { font-size:1.45rem; }
            .login-body { padding:14px 16px 12px; }
            .w-temp { font-size:1.7rem; }
        }
    </style>
</head>
<body>

    <!-- Floating Bubbles -->
    <div class="bubbles">
        <div class="bbl"></div><div class="bbl"></div>
        <div class="bbl"></div><div class="bbl"></div>
        <div class="bbl"></div><div class="bbl"></div>
    </div>

    <audio id="bgAudio" src="/assets/welcome_music.mp3" preload="auto" loop></audio>

    <div class="stage">

        <!-- ── TOP ROW ── -->
        <div class="top-row">

            <!-- WEATHER -->
            <div class="gp weather">
                <div class="bar">
                    <div class="bar-left"><i class="fas fa-sun" style="color:#ffd43b;font-size:.8rem;"></i><span>Weather</span></div>
                    <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
                </div>
                <div class="w-body">
                    <div class="w-main">
                        <div class="sun">☀️</div>
                        <div>
                            <div class="w-temp" id="wTemp">24°</div>
                            <div class="w-desc" id="wDesc">Sunny</div>
                            <div class="w-feels" id="wFeels">Feels like 24°</div>
                        </div>
                    </div>
                    <div class="forecast">
                        <div class="fc"><span>Mon</span><i class="fas fa-sun fcs"></i><span>24°/18°</span></div>
                        <div class="fc"><span>Tue</span><i class="fas fa-sun fcs"></i><span>25°/19°</span></div>
                        <div class="fc"><span>Wed</span><i class="fas fa-sun fcs"></i><span>26°/19°</span></div>
                        <div class="fc"><span>Thu</span><i class="fas fa-sun fcs"></i><span>25°/18°</span></div>
                    </div>
                </div>
            </div>

            <!-- MUSIC -->
            <div class="gp music">
                <div class="bar">
                    <div class="bar-left"><i class="fas fa-music" style="color:#38bdf8;font-size:.8rem;"></i><span>Now Playing</span></div>
                    <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
                </div>
                <div class="m-body">
                    <div class="m-meta">
                        <img src="/assets/frutiger_aero_bg.jpg" class="album" alt="Art" />
                        <div style="flex:1;overflow:hidden;">
                            <div class="t-name">Ocean Breeze</div>
                            <div class="t-artist">Clear Skies</div>
                            <div class="t-album">A Brighter Tomorrow</div>
                        </div>
                    </div>
                    <div class="scrub-wrap">
                        <input type="range" class="scrub" id="scrubber" value="0" min="0" max="100" />
                        <div class="t-labels">
                            <span id="curT">00:00</span>
                            <span id="totT">04:28</span>
                        </div>
                    </div>
                    <div class="m-ctrl">
                        <button class="cbtn"><i class="fas fa-random"></i></button>
                        <button class="cbtn"><i class="fas fa-step-backward"></i></button>
                        <button class="play-btn" id="btnPP"><i class="fas fa-play" id="pIcon"></i></button>
                        <button class="cbtn"><i class="fas fa-step-forward"></i></button>
                        <button class="cbtn" id="btnMute"><i class="fas fa-volume-up" id="vIcon"></i></button>
                    </div>
                </div>
            </div>

        </div>

        <!-- ── CENTER ROW ── -->
        <div class="center-row">

            <!-- CLOCK (desktop only) -->
            <div class="gp clock-panel">
                <div class="globe"><i class="fas fa-globe-americas"></i></div>
                <div class="ck-time" id="ckTime">10:24 AM</div>
                <div class="ck-date" id="ckDate">Saturday, May 15, 2004</div>
                <div class="eco"><i class="fas fa-leaf"></i><span>A Cleaner<br>Brighter<br>Together</span></div>
            </div>

            <!-- LOGIN CARD -->
            <div class="gp login-card">
                <div class="bar">
                    <div class="bar-left"><i class="fas fa-futbol" style="color:#38bdf8;font-size:.8rem;"></i><span>Match Registration</span></div>
                    <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
                </div>

                <div class="login-body">

                    <!-- Avatar -->
                    <div class="avatar" onclick="document.getElementById('photoInput').click()">
                        <i class="fas fa-user" id="avIcon"></i>
                        <img id="avImg" src="" style="display:none;" alt="Avatar" />
                    </div>

                    <div class="login-title">Welcome</div>
                    <div class="login-sub">Sign in to continue</div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="err-box">
                            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Submit" method="post" enctype="multipart/form-data" id="regForm">
                        @Html.AntiForgeryToken()
                        <input type="file" id="photoInput" name="profilePhoto" accept="image/*"
                               style="display:none;" onchange="prevAvatar(this)" />
                        <!-- Defaults -->
                        <input type="hidden" name="Status" value="جاي أكيد" />
                        <input type="hidden" name="Note"   value="" />

                        <!-- Phone Number -->
                        <div class="fw">
                            <i class="fas fa-phone-alt fi"></i>
                            <input type="tel" name="PhoneNumber" class="gf"
                                   placeholder="Phone Number"
                                   required autocomplete="tel" />
                        </div>

                        <!-- Full Name -->
                        <div class="fw">
                            <i class="fas fa-user fi"></i>
                            <input type="text" name="FriendName" class="gf"
                                   placeholder="Full Name"
                                   required autocomplete="name" />
                        </div>

                        <!-- Password -->
                        <div class="fw">
                            <i class="fas fa-lock fi"></i>
                            <input type="password" name="Password" id="passField"
                                   class="gf" style="padding-right:40px;"
                                   placeholder="Password"
                                   required minlength="4"
                                   autocomplete="current-password" />
                            <button type="button" class="eye" onclick="togglePass()">
                                <i class="fas fa-eye" id="eyeIco"></i>
                            </button>
                        </div>

                        <!-- Sign In -->
                        <button type="submit" class="signin" id="signBtn">
                            <span>Sign In</span>
                            <span class="arr"><i class="fas fa-arrow-right"></i></span>
                        </button>
                    </form>

                    <!-- Footer -->
                    <div class="login-foot">
                        <label>
                            <input type="checkbox" checked style="accent-color:#38bdf8;" />
                            Remember me
                        </label>
                        <a asp-controller="Home" asp-action="Login">Forgot password?</a>
                    </div>

                    <!-- Taskbar -->
                    <div class="taskbar">
                        <div class="ti" onclick="toggleMusic()">
                            <i class="fas fa-globe"></i><span>Options</span>
                        </div>
                        <a asp-controller="Home" asp-action="Login" class="ti">
                            <i class="fas fa-cog"></i><span>Settings</span>
                        </a>
                        <div class="ti" onclick="location.href='/Home/Room'">
                            <i class="fas fa-power-off"></i><span>Shut down</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- Autoplay toast -->
    <div class="toast" id="toast" onclick="startMusic()" style="display:none;">
        <i class="fas fa-volume-up" style="color:#38bdf8;font-size:1.1rem;"></i>
        <span>Tap to play music 🎵</span>
    </div>

    <script>
        // ── MUSIC ──
        const audio   = document.getElementById('bgAudio');
        const btnPP   = document.getElementById('btnPP');
        const pIcon   = document.getElementById('pIcon');
        const scrub   = document.getElementById('scrubber');
        const curT    = document.getElementById('curT');
        const totT    = document.getElementById('totT');
        const vIcon   = document.getElementById('vIcon');
        const toast   = document.getElementById('toast');
        let playing = false;

        function fmt(s) {
            if (isNaN(s)) return '00:00';
            const m = Math.floor(s/60), x = Math.floor(s%60);
            return (m<10?'0'+m:m)+':'+(x<10?'0'+x:x);
        }

        function startMusic() {
            audio.play().then(()=>{
                playing = true;
                pIcon.className = 'fas fa-pause';
                toast.style.display = 'none';
            }).catch(()=>{ toast.style.display = 'flex'; });
        }

        function pauseMusic() {
            audio.pause(); playing = false;
            pIcon.className = 'fas fa-play';
        }

        function toggleMusic() { playing ? pauseMusic() : startMusic(); }

        btnPP.addEventListener('click', toggleMusic);

        // Autoplay + fallback on first interaction
        window.addEventListener('DOMContentLoaded', ()=>{
            startMusic();
            const unlock = ()=>{
                if(!playing) startMusic();
                document.removeEventListener('click',     unlock);
                document.removeEventListener('touchstart',unlock);
                document.removeEventListener('keydown',   unlock);
            };
            document.addEventListener('click',     unlock);
            document.addEventListener('touchstart',unlock);
            document.addEventListener('keydown',   unlock);
        });

        audio.addEventListener('timeupdate', ()=>{
            if (audio.duration) {
                scrub.value = (audio.currentTime / audio.duration) * 100;
                curT.textContent = fmt(audio.currentTime);
                totT.textContent = fmt(audio.duration);
            }
        });
        audio.addEventListener('loadedmetadata', ()=>{ totT.textContent = fmt(audio.duration); });
        scrub.addEventListener('input', ()=>{
            if (audio.duration) audio.currentTime = (scrub.value/100)*audio.duration;
        });
        document.getElementById('btnMute').addEventListener('click', ()=>{
            audio.muted = !audio.muted;
            vIcon.className = audio.muted ? 'fas fa-volume-mute' : 'fas fa-volume-up';
        });

        // ── CLOCK ──
        function updateClock(){
            const n = new Date();
            let h = n.getHours(), m = n.getMinutes(), ap = h>=12?'PM':'AM';
            h = h%12||12;
            document.getElementById('ckTime').textContent =
                h+':'+(m<10?'0'+m:m)+' '+ap;
            const days   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            document.getElementById('ckDate').textContent =
                days[n.getDay()]+', '+months[n.getMonth()]+' '+n.getDate()+', '+n.getFullYear();
        }
        setInterval(updateClock, 1000); updateClock();

        // ── WEATHER ──
        fetch('https://api.open-meteo.com/v1/forecast?latitude=30.0444&longitude=31.2357&current_weather=true')
            .then(r=>r.json()).then(d=>{
                if(d&&d.current_weather){
                    const t = Math.round(d.current_weather.temperature);
                    document.getElementById('wTemp').textContent  = t+'°';
                    document.getElementById('wFeels').textContent = 'Feels like '+t+'°';
                }
            }).catch(()=>{});

        // ── FORM ──
        function togglePass(){
            const f = document.getElementById('passField');
            const i = document.getElementById('eyeIco');
            f.type = f.type==='password' ? 'text' : 'password';
            i.className = f.type==='password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }

        function prevAvatar(inp){
            if(inp.files&&inp.files[0]){
                const r = new FileReader();
                r.onload = e=>{
                    document.getElementById('avIcon').style.display='none';
                    const img=document.getElementById('avImg');
                    img.src=e.target.result; img.style.display='block';
                };
                r.readAsDataURL(inp.files[0]);
            }
        }

        document.getElementById('regForm').addEventListener('submit',()=>{
            const b = document.getElementById('signBtn');
            b.innerHTML='<span>Signing in...</span><i class="fas fa-spinner fa-spin"></i>';
            b.style.opacity='0.85';
        });
    </script>
</body>
</html>