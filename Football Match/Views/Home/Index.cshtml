@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>⚽ تأكيد الحضور - Frutiger Aero Windows</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Segoe+UI:wght@400;600;700;800&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', 'Tajawal', Tahoma, sans-serif;
            min-height: 100vh;
            background: #0288d1 url('/assets/frutiger_aero_bg.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #ffffff;
            position: relative;
            overflow-x: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 16px;
        }

        /* ===== FLOATING WATER BUBBLES ===== */
        .bubbles-layer {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 1;
        }

        .water-bubble {
            position: absolute;
            bottom: -90px;
            border-radius: 50%;
            background: radial-gradient(circle at 32% 32%, rgba(255, 255, 255, 0.9), rgba(186, 230, 253, 0.35) 60%, rgba(2, 132, 199, 0.2) 90%);
            box-shadow: 0 0 16px rgba(255, 255, 255, 0.6), inset 0 0 12px rgba(255, 255, 255, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.65);
            animation: riseBubble 16s infinite ease-in;
        }

        .water-bubble:nth-child(1) { left: 7%; width: 45px; height: 45px; animation-duration: 18s; animation-delay: 0s; }
        .water-bubble:nth-child(2) { left: 20%; width: 75px; height: 75px; animation-duration: 22s; animation-delay: 3s; }
        .water-bubble:nth-child(3) { left: 52%; width: 36px; height: 36px; animation-duration: 15s; animation-delay: 5s; }
        .water-bubble:nth-child(4) { left: 74%; width: 60px; height: 60px; animation-duration: 19s; animation-delay: 2s; }
        .water-bubble:nth-child(5) { left: 90%; width: 50px; height: 50px; animation-duration: 24s; animation-delay: 7s; }

        @@keyframes riseBubble {
            0% { transform: translateY(0) scale(0.85); opacity: 0; }
            10% { opacity: 0.85; }
            90% { opacity: 0.85; }
            100% { transform: translateY(-110vh) scale(1.15); opacity: 0; }
        }

        /* ===== MAIN AERO LAYOUT ===== */
        .aero-stage {
            width: 100%;
            max-width: 1180px;
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Top Widgets Row: Weather on Left, Music on Right */
        .aero-top-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            width: 100%;
        }

        /* Center Row: Clock on right, Welcome Card in center */
        .aero-center-row {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            width: 100%;
        }

        /* ===== ULTRA-TRANSPARENT WATER BUBBLE GLASS CARD ===== */
        .bubble-glass-panel {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(186, 230, 253, 0.10) 50%, rgba(255, 255, 255, 0.08) 100%);
            backdrop-filter: blur(10px) saturate(150%);
            -webkit-backdrop-filter: blur(10px) saturate(150%);
            border: 1.5px solid rgba(255, 255, 255, 0.75);
            border-radius: 26px;
            box-shadow: 
                0 20px 50px rgba(0, 45, 95, 0.28),
                inset 0 1.5px 1px rgba(255, 255, 255, 0.95),
                inset 0 0 25px rgba(255, 255, 255, 0.12),
                0 0 25px rgba(56, 189, 248, 0.25);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        /* 3D Curved Specular Bubble Highlight */
        .bubble-glass-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 42%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0.06) 80%, transparent 100%);
            border-radius: 25px 25px 50% 50% / 25px 25px 22% 22%;
            pointer-events: none;
            z-index: 2;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.25);
            font-size: 0.82rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
            user-select: none;
            position: relative;
            z-index: 3;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .panel-controls {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .panel-btn {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.65);
            background: rgba(255, 255, 255, 0.25);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.15s;
            line-height: 1;
        }
        .panel-btn:hover { background: rgba(255, 255, 255, 0.6); color: #032b57; }
        .panel-btn.close:hover { background: #ef4444; color: #fff; border-color: #ef4444; }

        /* ===== 1. WEATHER WIDGET (Top-Left) ===== */
        .weather-panel {
            width: 250px;
            flex-shrink: 0;
        }

        .weather-content {
            padding: 14px 16px 16px;
            text-align: center;
            position: relative;
            z-index: 3;
        }

        .weather-main {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-bottom: 12px;
        }

        .sun-glowing {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #fff9db, #ffd43b 50%, #f59f00 100%);
            box-shadow: 0 0 25px rgba(255, 212, 59, 0.9), 0 0 45px rgba(255, 179, 0, 0.5);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: #d9480f;
            flex-shrink: 0;
        }

        .weather-temp {
            font-size: 2.3rem;
            font-weight: 800;
            line-height: 1;
            color: #ffffff;
            text-shadow: 0 2px 4px rgba(0, 35, 80, 0.7);
        }

        .weather-status {
            font-size: 0.88rem;
            font-weight: 700;
            color: #e0f2fe;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .weather-feels {
            font-size: 0.72rem;
            color: rgba(224, 242, 254, 0.85);
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .forecast-row {
            display: flex;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            padding: 8px 10px;
            font-size: 0.7rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .forecast-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
        }
        .forecast-sun { color: #fcc419; font-size: 0.85rem; }

        /* ===== 2. NOW PLAYING MUSIC WIDGET (Top-Right) ===== */
        .music-panel {
            width: 320px;
            flex-shrink: 0;
        }

        .music-content {
            padding: 14px 16px 14px;
            position: relative;
            z-index: 3;
        }

        .music-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .album-art {
            width: 58px;
            height: 58px;
            border-radius: 14px;
            object-fit: cover;
            border: 1.5px solid rgba(255, 255, 255, 0.85);
            box-shadow: 0 4px 15px rgba(0, 60, 130, 0.4);
            flex-shrink: 0;
        }

        .track-info {
            flex: 1;
            overflow: hidden;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.7);
        }

        .track-title {
            font-size: 0.96rem;
            font-weight: 800;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-artist {
            font-size: 0.76rem;
            font-weight: 600;
            color: #bae6fd;
        }

        .track-album {
            font-size: 0.68rem;
            color: rgba(224, 242, 254, 0.8);
        }

        /* Scrubber */
        .music-scrubber {
            margin-bottom: 10px;
        }

        .time-range {
            width: 100%;
            height: 5px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255, 255, 255, 0.35);
            border-radius: 3px;
            outline: none;
            cursor: pointer;
            box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
        }

        .time-range::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #38bdf8;
            border: 2px solid #ffffff;
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.9);
            cursor: pointer;
            transition: transform 0.15s;
        }
        .time-range::-webkit-slider-thumb:hover { transform: scale(1.25); }

        .time-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.68rem;
            font-weight: 700;
            color: #ffffff;
            margin-top: 3px;
            font-family: Consolas, monospace;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .player-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6px;
        }

        .btn-ctrl {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.15s;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
            padding: 4px;
        }
        .btn-ctrl:hover { color: #38bdf8; transform: scale(1.12); }

        .btn-play-bubble {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #7dd3fc, #0284c7 60%, #0369a1 100%);
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 0 15px rgba(2, 132, 199, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-play-bubble:hover {
            transform: scale(1.1);
            box-shadow: 0 0 22px rgba(2, 132, 199, 0.9);
        }

        /* ===== 3. CLOCK WIDGET (Middle-Right on Desktop) ===== */
        .clock-panel {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 175px;
            text-align: center;
            padding: 16px 14px;
            display: none;
            z-index: 5;
        }

        @@media (min-width: 992px) {
            .clock-panel { display: block; }
        }

        .earth-icon {
            font-size: 2.4rem;
            color: #38bdf8;
            filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.8));
            margin-bottom: 8px;
            display: inline-block;
        }

        .clock-time {
            font-size: 1.35rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
            text-shadow: 0 1px 3px rgba(0, 35, 80, 0.7);
        }

        .clock-date {
            font-size: 0.74rem;
            color: rgba(224, 242, 254, 0.9);
            font-weight: 600;
            margin-top: 4px;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .eco-badge {
            margin-top: 8px;
            font-size: 0.66rem;
            color: #a7f3d0;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            background: rgba(16, 185, 129, 0.25);
            border: 1px solid rgba(16, 185, 129, 0.4);
            border-radius: 8px;
            padding: 3px 6px;
        }

        /* ===== 4. WELCOME LOGIN & REGISTRATION CARD (Center) ===== */
        .welcome-panel {
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .welcome-content {
            padding: 24px 26px 20px;
            text-align: center;
            position: relative;
            z-index: 3;
        }

        /* User Avatar Sphere */
        .avatar-sphere-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 12px;
            cursor: pointer;
        }

        .avatar-sphere {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.9), rgba(186, 230, 253, 0.7) 60%, rgba(2, 132, 199, 0.8) 100%);
            border: 2.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 0 25px rgba(2, 132, 199, 0.6), inset 0 2px 4px rgba(255, 255, 255, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            overflow: hidden;
            transition: all 0.25s;
        }
        .avatar-sphere:hover {
            transform: scale(1.05);
            box-shadow: 0 0 35px rgba(56, 189, 248, 0.8);
        }

        .avatar-sphere i {
            font-size: 2.7rem;
            color: #0369a1;
        }

        .avatar-sphere img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar-hint {
            font-size: 0.72rem;
            color: #e0f2fe;
            font-weight: 700;
            margin-top: 4px;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .welcome-heading {
            font-size: 1.65rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 2px;
            text-shadow: 0 2px 4px rgba(0, 35, 80, 0.7);
        }

        .welcome-sub {
            font-size: 0.84rem;
            color: rgba(224, 242, 254, 0.9);
            font-weight: 600;
            margin-bottom: 18px;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        /* Glass Input Fields */
        .glass-input-wrapper {
            position: relative;
            margin-bottom: 11px;
            text-align: right;
        }

        .glass-input-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #bae6fd;
            font-size: 0.95rem;
            pointer-events: none;
            filter: drop-shadow(0 1px 2px rgba(0, 35, 80, 0.6));
        }

        .glass-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(8px);
            border: 1.5px solid rgba(255, 255, 255, 0.65);
            border-radius: 12px;
            padding: 10px 42px 10px 14px;
            font-size: 0.92rem;
            font-weight: 600;
            color: #ffffff;
            outline: none;
            transition: all 0.2s;
            box-shadow: inset 0 1px 3px rgba(0, 30, 70, 0.15), 0 1px 0 rgba(255, 255, 255, 0.4);
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.5);
        }

        .glass-input:focus {
            background: rgba(255, 255, 255, 0.28);
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.4), inset 0 1px 2px rgba(0, 0, 0, 0.1);
        }

        .glass-input::placeholder {
            color: rgba(224, 242, 254, 0.7);
            font-weight: 500;
        }

        .pw-eye-btn {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.75);
            cursor: pointer;
            padding: 4px;
            font-size: 0.9rem;
            transition: color 0.15s;
        }
        .pw-eye-btn:hover { color: #38bdf8; }

        /* Status Options (Water Bubble Style) */
        .status-row {
            display: flex;
            gap: 8px;
            margin: 14px 0 12px;
        }

        .status-bubble {
            flex: 1;
            padding: 9px 6px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.14);
            border: 1.5px solid rgba(255, 255, 255, 0.55);
            font-size: 0.8rem;
            font-weight: 700;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            user-select: none;
            backdrop-filter: blur(6px);
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .status-bubble:hover {
            background: rgba(255, 255, 255, 0.28);
            transform: translateY(-2px);
        }

        .status-bubble.selected-going {
            background: radial-gradient(circle at 35% 35%, rgba(34, 197, 94, 0.5), rgba(22, 163, 74, 0.8));
            border-color: #86efac;
            box-shadow: 0 0 15px rgba(34, 197, 94, 0.6);
        }
        .status-bubble.selected-maybe {
            background: radial-gradient(circle at 35% 35%, rgba(245, 158, 11, 0.5), rgba(217, 119, 6, 0.8));
            border-color: #fde047;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
        }
        .status-bubble.selected-notgoing {
            background: radial-gradient(circle at 35% 35%, rgba(239, 68, 68, 0.5), rgba(220, 38, 38, 0.8));
            border-color: #fca5a5;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.6);
        }

        /* Sign In Cyan Glossy Button */
        .signin-bubble-btn {
            width: 100%;
            padding: 12px 20px;
            background: linear-gradient(180deg, #38bdf8 0%, #0ea5e9 48%, #0284c7 52%, #0369a1 100%);
            border: 2px solid rgba(255, 255, 255, 0.95);
            border-radius: 30px;
            color: #ffffff;
            font-size: 1.08rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.25s;
            box-shadow: 
                0 8px 25px rgba(2, 132, 199, 0.55),
                inset 0 1px 1px rgba(255, 255, 255, 0.9),
                inset 0 -2px 4px rgba(0, 40, 80, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 6px;
            text-shadow: 0 1px 2px rgba(0, 30, 70, 0.8);
        }

        .signin-bubble-btn:hover {
            background: linear-gradient(180deg, #7dd3fc 0%, #38bdf8 48%, #0284c7 52%, #0284c7 100%);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(2, 132, 199, 0.75);
        }

        .btn-arrow-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.8);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }

        .welcome-footer-links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 14px;
            font-size: 0.78rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
        }

        .welcome-footer-links a {
            color: #bae6fd;
            text-decoration: none;
            transition: color 0.15s;
        }
        .welcome-footer-links a:hover { color: #ffffff; text-decoration: underline; }

        /* Window Bottom Options (Options, Settings, Shut down) */
        .bottom-taskbar {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 26px;
            padding-top: 16px;
            margin-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.25);
        }

        .bottom-task-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            font-size: 0.7rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .bottom-task-item:hover {
            color: #38bdf8;
            transform: translateY(-2px);
        }
        .bottom-task-item i {
            font-size: 1.15rem;
        }

        /* Floating Audio Prompt Toast */
        .audio-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(15px);
            border: 1.5px solid rgba(255, 255, 255, 0.8);
            border-radius: 16px;
            padding: 10px 18px;
            box-shadow: 0 12px 30px rgba(0, 50, 120, 0.35);
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 35, 80, 0.6);
            z-index: 1000;
            cursor: pointer;
            animation: toastSlide 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @@keyframes toastSlide {
            from { transform: translateY(50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Mobile Layout */
        @@media (max-width: 991px) {
            .aero-top-row {
                flex-direction: column;
                align-items: stretch;
            }
            .weather-panel, .music-panel {
                width: 100%;
            }
            .welcome-panel {
                max-width: 100%;
            }
            body {
                padding: 14px 10px 40px;
            }
        }
    </style>
</head>
<body>

    <!-- Floating Water Bubbles -->
    <div class="bubbles-layer">
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
    </div>

    <!-- Hidden HTML5 Audio Element -->
    <audio id="bgMusic" src="/assets/welcome_music.mp3" preload="auto" loop></audio>

    <div class="aero-stage">

        <!-- Top Widgets Row (Weather on Left, Now Playing on Right) -->
        <div class="aero-top-row">

            <!-- 1. WEATHER WIDGET (Top-Left) -->
            <div class="bubble-glass-panel weather-panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <i class="fas fa-sun" style="color:#ffd43b;"></i>
                        <span>Weather</span>
                    </div>
                    <div class="panel-controls">
                        <button type="button" class="panel-btn" title="تصغير">─</button>
                        <button type="button" class="panel-btn close" title="إغلاق">✕</button>
                    </div>
                </div>
                <div class="weather-content">
                    <div class="weather-main">
                        <div class="sun-glowing">
                            <i class="fas fa-sun"></i>
                        </div>
                        <div style="text-align: right;">
                            <div class="weather-temp" id="weatherTemp">24°</div>
                            <div class="weather-status" id="weatherDesc">Sunny</div>
                            <div class="weather-feels" id="weatherFeels">Feels like 24°</div>
                        </div>
                    </div>
                    <div class="forecast-row">
                        <div class="forecast-col">
                            <span>Mon</span>
                            <i class="fas fa-sun forecast-sun"></i>
                            <span>24°/18°</span>
                        </div>
                        <div class="forecast-col">
                            <span>Tue</span>
                            <i class="fas fa-sun forecast-sun"></i>
                            <span>25°/19°</span>
                        </div>
                        <div class="forecast-col">
                            <span>Wed</span>
                            <i class="fas fa-sun forecast-sun"></i>
                            <span>26°/19°</span>
                        </div>
                        <div class="forecast-col">
                            <span>Thu</span>
                            <i class="fas fa-sun forecast-sun"></i>
                            <span>25°/18°</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. MUSIC PLAYER WIDGET (Top-Right) -->
            <div class="bubble-glass-panel music-panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <i class="fas fa-music" style="color:#38bdf8;"></i>
                        <span>Now Playing</span>
                    </div>
                    <div class="panel-controls">
                        <button type="button" class="panel-btn" title="تصغير">─</button>
                        <button type="button" class="panel-btn close" title="إغلاق">✕</button>
                    </div>
                </div>
                <div class="music-content">
                    <div class="music-meta">
                        <img src="/assets/frutiger_aero_bg.jpg" class="album-art" alt="Album Art" />
                        <div class="track-info">
                            <div class="track-title">Ocean Breeze</div>
                            <div class="track-artist">Clear Skies</div>
                            <div class="track-album">A Brighter Tomorrow</div>
                        </div>
                    </div>

                    <!-- Scrubber Timeline -->
                    <div class="music-scrubber">
                        <input type="range" class="time-range" id="musicScrubber" value="0" min="0" max="100" />
                        <div class="time-labels">
                            <span id="currentTime">00:00</span>
                            <span id="totalDuration">02:05</span>
                        </div>
                    </div>

                    <!-- Controls: Shuffle, Prev, Play/Pause, Next, Volume -->
                    <div class="player-controls">
                        <button type="button" class="btn-ctrl" title="عشوائي"><i class="fas fa-random"></i></button>
                        <button type="button" class="btn-ctrl" id="btnPrev" title="السابق"><i class="fas fa-step-backward"></i></button>
                        <button type="button" class="btn-play-bubble" id="btnPlayPause" title="تشغيل / إيقاف">
                            <i class="fas fa-play" id="playIcon"></i>
                        </button>
                        <button type="button" class="btn-ctrl" id="btnNext" title="التالي"><i class="fas fa-step-forward"></i></button>
                        <button type="button" class="btn-ctrl" id="btnVolume" title="كتم / تشغيل الصوت"><i class="fas fa-volume-up" id="volIcon"></i></button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Center Row: Clock Widget on side & Main Welcome Registration Card in Center -->
        <div class="aero-center-row">

            <!-- 3. CLOCK & DATE WIDGET (Middle-Right on Desktop) -->
            <div class="bubble-glass-panel clock-panel">
                <i class="fas fa-globe-americas earth-icon"></i>
                <div class="clock-time" id="liveClockTime">10:24 AM</div>
                <div class="clock-date" id="liveClockDate">Saturday, May 15, 2004</div>
                <div class="eco-badge">
                    <i class="fas fa-leaf"></i>
                    <span>A Cleaner Tomorrow</span>
                </div>
            </div>

            <!-- 4. CENTER MAIN WELCOME REGISTRATION WINDOW -->
            <div class="bubble-glass-panel welcome-panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <i class="fas fa-futbol" style="color:#38bdf8;"></i>
                        <span>Match Registration • تأكيد الحضور</span>
                    </div>
                    <div class="panel-controls">
                        <button type="button" class="panel-btn" title="تصغير">─</button>
                        <button type="button" class="panel-btn close" title="إغلاق">✕</button>
                    </div>
                </div>

                <div class="welcome-content">
                    <!-- Avatar Area -->
                    <div class="avatar-sphere-wrapper" onclick="document.getElementById('profilePhoto').click()">
                        <div class="avatar-sphere" id="avatarBox">
                            <i class="fas fa-user" id="defaultUserIcon"></i>
                            <img id="avatarImg" src="" style="display:none;" />
                        </div>
                        <div class="avatar-hint"><i class="fas fa-camera me-1"></i>صورة شخصية (اختياري)</div>
                    </div>

                    <h1 class="welcome-heading">Welcome</h1>
                    <p class="welcome-sub">Sign in to continue • سجّل موقفك وانضم للغرفة</p>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div style="background:rgba(239,68,68,0.3);border:1px solid rgba(239,68,68,0.7);color:#ffffff;border-radius:12px;padding:8px 12px;margin-bottom:14px;font-size:0.82rem;font-weight:700;text-shadow:0 1px 2px rgba(0,0,0,0.5);">
                            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Submit" method="post" enctype="multipart/form-data" id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="file" id="profilePhoto" name="profilePhoto" accept="image/*" style="display:none;" onchange="previewPhoto(this)" />

                        <!-- Phone / Username -->
                        <div class="glass-input-wrapper">
                            <i class="fas fa-phone-alt glass-input-icon"></i>
                            <input type="tel" name="PhoneNumber" class="glass-input" placeholder="رقم الموبايل (01xxxxxxxxx)" required autocomplete="tel" />
                        </div>

                        <!-- Password -->
                        <div class="glass-input-wrapper">
                            <i class="fas fa-lock glass-input-icon"></i>
                            <input type="password" id="userPasswordInput" name="Password" class="glass-input" style="padding-left:42px;" placeholder="كلمة السر..." required minlength="4" autocomplete="current-password" />
                            <button type="button" class="pw-eye-btn" onclick="togglePasswordVisibility()" title="إظهار/إخفاء">
                                <i class="fas fa-eye" id="pwIcon"></i>
                            </button>
                        </div>

                        <!-- Name -->
                        <div class="glass-input-wrapper">
                            <i class="fas fa-user-tag glass-input-icon"></i>
                            <input type="text" name="FriendName" class="glass-input" placeholder="اسمك بالكامل..." required autocomplete="name" />
                        </div>

                        <!-- Status Selection (Pill Buttons) -->
                        <div style="text-align:right;margin:12px 0 4px;">
                            <label style="font-size:0.8rem;font-weight:700;color:#ffffff;text-shadow:0 1px 2px rgba(0,35,80,0.7);">موقفك من الماتش:</label>
                            <div class="status-row">
                                <div class="status-bubble selected-going" onclick="pickStatus('جاي أكيد', this, 'selected-going')">
                                    <span style="font-size:1.1rem;">✅</span>
                                    <span>جاي أكيد</span>
                                </div>
                                <div class="status-bubble" onclick="pickStatus('احتمال أجي', this, 'selected-maybe')">
                                    <span style="font-size:1.1rem;">❓</span>
                                    <span>احتمال أجي</span>
                                </div>
                                <div class="status-bubble" onclick="pickStatus('مش جاي', this, 'selected-notgoing')">
                                    <span style="font-size:1.1rem;">❌</span>
                                    <span>مش جاي</span>
                                </div>
                            </div>
                            <input type="hidden" name="Status" id="selectedStatusInput" value="جاي أكيد" />
                        </div>

                        <!-- Note -->
                        <div class="glass-input-wrapper">
                            <i class="fas fa-comment-dots glass-input-icon"></i>
                            <input type="text" name="Note" class="glass-input" placeholder="ملاحظة إضافية (اختياري)..." />
                        </div>

                        <!-- Submit Button (Glossy Cyan Aero Pill) -->
                        <button type="submit" class="signin-bubble-btn" id="submitBtn">
                            <span>Sign In • تأكيد الدخول</span>
                            <span class="btn-arrow-circle"><i class="fas fa-arrow-left"></i></span>
                        </button>
                    </form>

                    <!-- Links Row -->
                    <div class="welcome-footer-links">
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
                            <input type="checkbox" checked style="accent-color:#38bdf8;" />
                            <span>Remember me • تذكرني</span>
                        </label>
                        <a asp-controller="Home" asp-action="Login">دخول الأدمن 🔐</a>
                    </div>

                    <!-- Bottom Bar (Options, Settings, Shut down) -->
                    <div class="bottom-taskbar">
                        <div class="bottom-task-item" onclick="toggleMusicPlayback()">
                            <i class="fas fa-globe"></i>
                            <span>Options</span>
                        </div>
                        <a asp-controller="Home" asp-action="Login" class="bottom-task-item">
                            <i class="fas fa-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="/Home/Room" class="bottom-task-item">
                            <i class="fas fa-power-off"></i>
                            <span>Shut down</span>
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- Autoplay Notification Toast (إذا منع المتصفح الصوت قبل النقرة الأولى) -->
    <div class="audio-toast" id="autoplayPrompt" onclick="startMusicFromToast()" style="display:none;">
        <i class="fas fa-volume-up fa-lg" style="color:#38bdf8;"></i>
        <span>اضغط هنا لتشغيل الموسيقى 🎵</span>
    </div>

    <script>
        // ===== MUSIC PLAYER SCRIPT =====
        const audio = document.getElementById("bgMusic");
        const btnPlayPause = document.getElementById("btnPlayPause");
        const playIcon = document.getElementById("playIcon");
        const scrubber = document.getElementById("musicScrubber");
        const currentTimeEl = document.getElementById("currentTime");
        const totalDurationEl = document.getElementById("totalDuration");
        const btnVolume = document.getElementById("btnVolume");
        const volIcon = document.getElementById("volIcon");
        const autoplayToast = document.getElementById("autoplayPrompt");

        let isPlaying = false;

        function formatTime(seconds) {
            if (isNaN(seconds)) return "00:00";
            const mins = Math.floor(seconds / 60);
            const secs = Math.floor(seconds % 60);
            return (mins < 10 ? "0" + mins : mins) + ":" + (secs < 10 ? "0" + secs : secs);
        }

        function playMusic() {
            audio.play().then(() => {
                isPlaying = true;
                playIcon.className = "fas fa-pause";
                if (autoplayToast) autoplayToast.style.display = "none";
            }).catch(err => {
                console.log("Autoplay paused by browser policy:", err);
                if (autoplayToast) autoplayToast.style.display = "flex";
            });
        }

        function pauseMusic() {
            audio.pause();
            isPlaying = false;
            playIcon.className = "fas fa-play";
        }

        btnPlayPause.addEventListener("click", () => {
            if (isPlaying) {
                pauseMusic();
            } else {
                playMusic();
            }
        });

        function startMusicFromToast() {
            playMusic();
            if (autoplayToast) autoplayToast.style.display = "none";
        }

        // Try autoplay on page load + unlock on first interaction
        window.addEventListener("DOMContentLoaded", () => {
            playMusic();

            const startOnInteraction = () => {
                if (!isPlaying) {
                    playMusic();
                }
                document.removeEventListener("click", startOnInteraction);
                document.removeEventListener("touchstart", startOnInteraction);
                document.removeEventListener("keydown", startOnInteraction);
            };

            document.addEventListener("click", startOnInteraction);
            document.addEventListener("touchstart", startOnInteraction);
            document.addEventListener("keydown", startOnInteraction);
        });

        // Track scrubber update
        audio.addEventListener("timeupdate", () => {
            if (audio.duration) {
                const percent = (audio.currentTime / audio.duration) * 100;
                scrubber.value = percent;
                currentTimeEl.textContent = formatTime(audio.currentTime);
                totalDurationEl.textContent = formatTime(audio.duration);
            }
        });

        audio.addEventListener("loadedmetadata", () => {
            totalDurationEl.textContent = formatTime(audio.duration);
        });

        // Seek
        scrubber.addEventListener("input", () => {
            if (audio.duration) {
                const seekTo = (scrubber.value / 100) * audio.duration;
                audio.currentTime = seekTo;
            }
        });

        // Volume Toggle
        btnVolume.addEventListener("click", () => {
            audio.muted = !audio.muted;
            if (audio.muted) {
                volIcon.className = "fas fa-volume-mute";
            } else {
                volIcon.className = "fas fa-volume-up";
            }
        });

        function toggleMusicPlayback() {
            if (isPlaying) pauseMusic();
            else playMusic();
        }

        // ===== WEATHER & CLOCK DYNAMIC UPDATES =====
        function updateLiveClock() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = now.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const timeStr = `${hours}:${minutes < 10 ? '0' + minutes : minutes} ${ampm}`;
            
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            const dateStr = `${days[now.getDay()]}, ${months[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;

            const clockEl = document.getElementById("liveClockTime");
            const dateEl = document.getElementById("liveClockDate");
            if (clockEl) clockEl.textContent = timeStr;
            if (dateEl) dateEl.textContent = dateStr;
        }

        setInterval(updateLiveClock, 1000);
        updateLiveClock();

        // Optional Live Weather fetch via Open-Meteo
        fetch("https://api.open-meteo.com/v1/forecast?latitude=30.0444&longitude=31.2357&current_weather=true")
            .then(res => res.json())
            .then(data => {
                if (data && data.current_weather) {
                    const temp = Math.round(data.current_weather.temperature);
                    const tempEl = document.getElementById("weatherTemp");
                    const feelsEl = document.getElementById("weatherFeels");
                    if (tempEl) tempEl.textContent = temp + "°";
                    if (feelsEl) feelsEl.textContent = `Feels like ${temp}°`;
                }
            })
            .catch(() => { /* Default to iconic 24° Sunny */ });

        // ===== FORM INTERACTION =====
        function pickStatus(val, el, cls) {
            document.querySelectorAll(".status-bubble").forEach(b => {
                b.classList.remove("selected-going", "selected-maybe", "selected-notgoing");
            });
            el.classList.add(cls);
            document.getElementById("selectedStatusInput").value = val;
        }

        function togglePasswordVisibility() {
            const input = document.getElementById("userPasswordInput");
            const icon = document.getElementById("pwIcon");
            if (input.type === "password") {
                input.type = "text";
                icon.className = "fas fa-eye-slash";
            } else {
                input.type = "password";
                icon.className = "fas fa-eye";
            }
        }

        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    const userIcon = document.getElementById("defaultUserIcon");
                    const img = document.getElementById("avatarImg");
                    userIcon.style.display = "none";
                    img.src = e.target.result;
                    img.style.display = "block";
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("submitBtn");
            if (btn) {
                btn.innerHTML = '<span>جاري الدخول...</span> <i class="fas fa-spinner fa-spin"></i>';
                btn.style.opacity = '0.85';
            }
        });
    </script>
</body>
</html>