@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تأكيد حضور الماتش</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <style>
            body {
                background-color: #121212;
                color: #ffffff;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .card {
                background-color: #1e1e1e;
                border: 1px solid #333;
                border-radius: 16px;
            }

            .option-card {
                cursor: pointer;
                user-select: none;
                transition: all 0.2s ease-in-out;
            }

                .option-card:hover {
                    border-color: #0d6efd !important;
                    background-color: #2b2b2b !important;
                }

                .option-card:has(input:checked) {
                    border-color: #0d6efd !important;
                    background-color: #1a2736 !important;
                }

            .form-control::placeholder {
                color: #888;
            }
    </style>
</head>
<body>

    <div class="container my-5" style="max-width: 480px;">
        <div class="card shadow-lg p-4 text-center">
            <div class="text-end mb-2">
                <a asp-controller="Home" asp-action="Login" class="btn btn-outline-secondary btn-sm text-white">🔐 أدمن</a>
            </div>

            <h2 class="fw-bold mb-2 text-white">⚽ تأكيد حضور الماتش</h2>
            <p class="text-light opacity-75 mb-2">اكتب رقم تليفونك واسمك لتسجيل أو تعديل موقفك!</p>
            <p class="text-info small mb-4">💡 رقم التليفون هو حسابك لتعديل موقفك في أي وقت.</p>

            <form asp-controller="Home" asp-action="Submit" method="post">
                <!-- رقم التليفون -->
                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold text-white">رقم الموبايل:</label>
                    <input type="tel" name="PhoneNumber" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="01xxxxxxxxx" required />
                </div>

                <!-- اسم الصديق -->
                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold text-white">اسمك بالكامل:</label>
                    <input type="text" name="FriendName" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="ادخل اسمك هنا..." required />
                </div>

                <!-- تحديد الموقف -->
                <div class="mb-4 text-start">
                    <label class="form-label fw-semibold text-white mb-3">جايب ولا لا؟</label>

                    <label class="option-card p-3 border border-secondary rounded mb-2 bg-dark d-flex align-items-center justify-content-between w-100" for="status1">
                        <span class="fw-bold text-success mb-0">✅ جاي أكيد</span>
                        <input class="form-check-input ms-2" type="radio" name="Status" id="status1" value="جاي أكيد" checked />
                    </label>

                    <label class="option-card p-3 border border-secondary rounded mb-2 bg-dark d-flex align-items-center justify-content-between w-100" for="status2">
                        <span class="fw-bold text-danger mb-0">❌ مش جاي</span>
                        <input class="form-check-input ms-2" type="radio" name="Status" id="status2" value="مش جاي" />
                    </label>

                    <label class="option-card p-3 border border-secondary rounded bg-dark d-flex align-items-center justify-content-between w-100" for="status3">
                        <span class="fw-bold text-warning mb-0">❓ احتمال أجي</span>
                        <input class="form-check-input ms-2" type="radio" name="Status" id="status3" value="احتمال أجي" />
                    </label>
                </div>

                <!-- ملاحظة اختيارية -->
                <div class="mb-4 text-start">
                    <label class="form-label fw-semibold text-white">ملاحظة (اختياري):</label>
                    <input type="text" name="Note" class="form-control bg-dark text-white border-secondary" placeholder="مثلاً: هتأخر 10 دقايق..." />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">تأكيد الإجابة 🚀</button>
            </form>
        </div>
    </div>

</body>
</html>