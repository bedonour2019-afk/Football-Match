@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>⚽ Match Registration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            width: 100%; height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: url('/assets/frutiger_aero_bg.jpg') no-repeat center center / cover fixed;
            color: #fff;
            overflow: hidden;
        }

        /* ── BUBBLES ── */
        .bubbles { position:fixed; inset:0; pointer-events:none; overflow:hidden; z-index:1; }
        .bbl {
            position:absolute; bottom:-80px; border-radius:50%;
            background: radial-gradient(circle at 30% 28%,
                rgba(255,255,255,0.95) 0%, rgba(186,230,253,0.55) 40%,
                rgba(56,189,248,0.10) 80%, transparent 100%);
            border:1px solid rgba(255,255,255,0.65);
            box-shadow: inset 0 0 8px rgba(255,255,255,0.50);
            animation: riseUp linear infinite;
        }
        .bbl:nth-child(1){left:5%;  width:34px; height:34px; animation-duration:19s; animation-delay:0s;}
        .bbl:nth-child(2){left:18%; width:58px; height:58px; animation-duration:25s; animation-delay:4s;}
        .bbl:nth-child(3){left:40%; width:24px; height:24px; animation-duration:17s; animation-delay:2s;}
        .bbl:nth-child(4){left:61%; width:48px; height:48px; animation-duration:22s; animation-delay:6s;}
        .bbl:nth-child(5){left:79%; width:38px; height:38px; animation-duration:16s; animation-delay:1s;}
        .bbl:nth-child(6){left:92%; width:62px; height:62px; animation-duration:28s; animation-delay:9s;}
        @@keyframes riseUp {
            0%  { transform:translateY(0)      scale(0.8); opacity:0;    }
            8%  {                                           opacity:0.82; }
            90% {                                           opacity:0.72; }
            100%{ transform:translateY(-105vh) scale(1.2); opacity:0;    }
        }

        /* ── STAGE ── */
        .stage {
            position:relative; z-index:10;
            width:100%; height:100%;
            display:flex; flex-direction:column;
            padding:1.2vh 2vw 1vh;
            gap:1.5vh;
        }

        .top-row    { display:flex; gap:1.5vw; flex-shrink:0; align-items:stretch; }
        .center-row { display:flex; gap:1.5vw; justify-content:center; align-items:flex-start; flex:1; min-height:0; }

        /* ── GLASS PANEL BASE ── */
        .gp {
            /* very transparent — background shows through clearly */
            background: rgba(180,220,255,0.08);
            backdrop-filter: blur(26px) saturate(180%);
            -webkit-backdrop-filter: blur(26px) saturate(180%);
            border: 1px solid rgba(255,255,255,0.55);
            border-radius: 18px;
            box-shadow:
                0 4px 24px rgba(0,50,120,0.12),
                inset 0 1.5px 0 rgba(255,255,255,0.75),
                inset 0 -1px 0 rgba(255,255,255,0.10);
            position:relative; overflow:hidden;
        }
        /* specular 3-D bubble curve */
        .gp::before {
            content:''; position:absolute; top:0; left:0; right:0; height:42%;
            background: linear-gradient(180deg,
                rgba(255,255,255,0.36) 0%, rgba(255,255,255,0.05) 75%, transparent 100%);
            border-radius: 18px 18px 55% 55% / 18px 18px 18% 18%;
            pointer-events:none; z-index:2;
        }

        /* title bar */
        .bar {
            display:flex; justify-content:space-between; align-items:center;
            padding:5px 12px;
            border-bottom:1px solid rgba(255,255,255,0.18);
            font-size:0.74rem; font-weight:700;
            color:rgba(255,255,255,0.95);
            text-shadow:0 1px 3px rgba(0,25,70,0.6);
            user-select:none; position:relative; z-index:3; flex-shrink:0;
        }
        .bar-left { display:flex; align-items:center; gap:5px; }
        .wbts     { display:flex; gap:4px; }
        .wb {
            width:13px; height:13px; border-radius:3px;
            border:1px solid rgba(255,255,255,0.45);
            background:rgba(255,255,255,0.18);
            display:inline-flex; align-items:center; justify-content:center;
            font-size:0.48rem; color:#fff; cursor:pointer;
        }
        .wb:hover   { background:rgba(255,255,255,0.50); }
        .wb.x:hover { background:#ef4444; }

        /* ── TOP PANELS (Weather & Music)
             Width  ≈ 41 vw each  | Height ≈ 13 vh  ── */
        .weather, .music {
            width: 41vw;
            height: 13vh;
            display:flex; flex-direction:column; flex-shrink:0;
            overflow:hidden;
        }

        /* ── WEATHER body ── */
        .w-body {
            padding:6px 14px 8px; flex:1; overflow:hidden;
            position:relative; z-index:3;
            display:flex; flex-direction:column; justify-content:space-between;
        }
        .w-main { display:flex; align-items:center; gap:10px; }
        .sun {
            width:36px; height:36px; border-radius:50%; flex-shrink:0;
            background:radial-gradient(circle at 35% 35%, #fff9c4, #ffd43b 55%, #f59f00);
            box-shadow:0 0 16px rgba(255,210,0,0.80);
            display:flex; align-items:center; justify-content:center; font-size:1.05rem;
        }
        .w-temp  { font-size:clamp(1.1rem,2vw,1.8rem); font-weight:800; text-shadow:0 2px 5px rgba(0,30,80,0.5); line-height:1; }
        .w-desc  { font-size:clamp(0.6rem,1vw,0.78rem); font-weight:700; color:#e0f2fe; }
        .w-feels { font-size:clamp(0.55rem,0.85vw,0.68rem); color:rgba(224,242,254,0.8); }
        .forecast {
            display:flex; justify-content:space-between;
            background:rgba(255,255,255,0.09);
            border:1px solid rgba(255,255,255,0.22);
            border-radius:9px; padding:4px 8px;
            font-size:clamp(0.55rem,0.8vw,0.65rem); font-weight:700; color:#fff;
        }
        .fc  { display:flex; flex-direction:column; align-items:center; gap:1px; }
        .fcs { color:#fcc419; font-size:0.72rem; }

        /* ── MUSIC body ── */
        .m-body {
            padding:6px 14px 7px; flex:1; overflow:hidden;
            position:relative; z-index:3;
            display:flex; flex-direction:column; justify-content:space-between;
        }
        .m-meta { display:flex; align-items:center; gap:9px; }
        .album  {
            width:clamp(36px,4vw,50px); height:clamp(36px,4vw,50px);
            border-radius:9px; object-fit:cover;
            border:1.5px solid rgba(255,255,255,0.60);
            box-shadow:0 3px 10px rgba(0,50,120,0.22); flex-shrink:0;
        }
        .t-name   { font-size:clamp(0.72rem,1.1vw,0.88rem); font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1px 3px rgba(0,30,80,0.6); }
        .t-artist { font-size:clamp(0.60rem,0.9vw,0.72rem); font-weight:600; color:#bae6fd; }
        .t-album  { font-size:clamp(0.56rem,0.8vw,0.65rem); color:rgba(224,242,254,0.75); }

        .scrub-wrap { flex-shrink:0; }
        .scrub {
            width:100%; height:4px; -webkit-appearance:none; appearance:none;
            background:rgba(255,255,255,0.26); border-radius:3px; outline:none; cursor:pointer;
        }
        .scrub::-webkit-slider-thumb {
            -webkit-appearance:none; width:12px; height:12px;
            border-radius:50%; background:#38bdf8;
            border:2px solid #fff; box-shadow:0 0 7px rgba(56,189,248,0.85); cursor:pointer;
        }
        .t-labels {
            display:flex; justify-content:space-between;
            font-size:0.60rem; font-weight:700; color:#fff;
            margin-top:2px; font-family:Consolas,monospace;
        }

        .m-ctrl { display:flex; align-items:center; justify-content:space-between; padding:0 2px; flex-shrink:0; }
        .cbtn {
            background:none; border:none; color:#fff;
            font-size:0.82rem; cursor:pointer; padding:3px;
            transition:all 0.15s; text-shadow:0 1px 3px rgba(0,30,80,0.5);
        }
        .cbtn:hover { color:#38bdf8; transform:scale(1.15); }
        .play-btn {
            width:32px; height:32px; border-radius:50%;
            background:radial-gradient(circle at 35% 35%, #7dd3fc, #0284c7 60%, #0369a1);
            border:2px solid rgba(255,255,255,0.88);
            box-shadow:0 0 12px rgba(2,132,199,0.65), inset 0 1px 0 rgba(255,255,255,0.75);
            color:#fff; display:flex; align-items:center; justify-content:center;
            font-size:0.82rem; cursor:pointer; transition:all 0.2s;
        }
        .play-btn:hover { transform:scale(1.1); box-shadow:0 0 20px rgba(2,132,199,0.9); }

        /* ── CLOCK (desktop only) ── */
        .clock-panel {
            width:clamp(130px,12vw,160px);
            flex-shrink:0; text-align:center;
            padding:14px 10px; display:none;
        }
        @@media (min-width:900px){ .clock-panel{ display:block; } }
        .globe   { font-size:clamp(1.6rem,2.2vw,2.2rem); color:#38bdf8; filter:drop-shadow(0 0 9px rgba(56,189,248,0.8)); margin-bottom:6px; }
        .ck-time { font-size:clamp(1rem,1.4vw,1.25rem); font-weight:800; text-shadow:0 1px 4px rgba(0,30,80,0.6); }
        .ck-date { font-size:clamp(0.58rem,0.8vw,0.68rem); color:rgba(224,242,254,0.88); font-weight:600; margin-top:3px; }
        .eco {
            margin-top:8px; font-size:0.60rem; color:#a7f3d0; font-weight:700;
            display:flex; align-items:center; justify-content:center; gap:3px;
            background:rgba(16,185,129,0.17); border:1px solid rgba(16,185,129,0.30);
            border-radius:7px; padding:3px 6px;
        }

        /* ── LOGIN CARD
             Width ≈ 57 vw  |  Height ≈ 35 vh  ── */
        .login-card {
            width: 57vw;
            height: 35vh;
            display:flex; flex-direction:column;
            overflow:hidden;
        }
        .login-body {
            padding:10px 6% 10px;
            text-align:center;
            position:relative; z-index:3;
            overflow-y:auto; flex:1;
            display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
        }
        .login-body::-webkit-scrollbar { display:none; }

        /* Avatar */
        .avatar {
            width: clamp(46px,5.5vh,68px);
            height: clamp(46px,5.5vh,68px);
            border-radius:50%; margin:0 auto 6px; flex-shrink:0;
            background:radial-gradient(circle at 38% 32%,
                rgba(255,255,255,0.9) 0%, rgba(147,210,255,0.65) 55%, rgba(2,132,199,0.7) 100%);
            border:2px solid rgba(255,255,255,0.85);
            box-shadow:0 0 20px rgba(56,189,248,0.45), inset 0 2px 4px rgba(255,255,255,0.80);
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; overflow:hidden; transition:all 0.25s;
        }
        .avatar:hover { transform:scale(1.05); }
        .avatar i   { font-size:clamp(1.2rem,2vh,2.2rem); color:#0369a1; }
        .avatar img { width:100%; height:100%; object-fit:cover; }

        .login-title { font-size:clamp(1.1rem,2.5vh,1.65rem); font-weight:800; text-shadow:0 2px 5px rgba(0,30,80,0.6); margin-bottom:1px; flex-shrink:0; }
        .login-sub   { font-size:clamp(0.65rem,1.2vh,0.80rem); color:rgba(224,242,254,0.9); font-weight:600; margin-bottom:8px; flex-shrink:0; }

        .err-box {
            width:83%; background:rgba(239,68,68,0.20); border:1px solid rgba(239,68,68,0.55);
            border-radius:9px; padding:6px 10px; margin-bottom:8px;
            font-size:0.76rem; font-weight:700; color:#fff; text-align:left; flex-shrink:0;
        }

        /* Form wrapper */
        .form-inner { width:100%; display:flex; flex-direction:column; align-items:center; }

        /* ── INPUT FIELDS
             Width  ≈ 83% of login card
             Height ≈ 7% of 35vh ≈ 2.45vh — achieved via padding  ── */
        .fw { position:relative; width:83%; margin-bottom:clamp(6px,0.8vh,10px); text-align:left; flex-shrink:0; }
        .fi {
            position:absolute; left:11px; top:50%; transform:translateY(-50%);
            color:#0369a1; font-size:clamp(0.72rem,1vh,0.86rem);
            pointer-events:none; z-index:1;
        }
        .gf {
            width:100%;
            /* INPUT TRANSPARENCY: 70-80% — background very visible */
            background: rgba(255,255,255,0.22);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.60);
            border-radius:10px;
            /* height ≈ 7% of 35vh ≈ 2.45vh → use padding to hit that */
            padding: clamp(7px,1.2vh,10px) 36px clamp(7px,1.2vh,10px) 34px;
            font-size:clamp(0.72rem,1.1vh,0.88rem); font-weight:600;
            color:#fff; outline:none;
            transition:all 0.2s;
            box-shadow: inset 0 1px 3px rgba(0,50,120,0.08);
        }
        .gf::placeholder { color:rgba(255,255,255,0.65); font-weight:500; }
        .gf:focus {
            background:rgba(255,255,255,0.32);
            border-color:#38bdf8;
            box-shadow:0 0 0 2.5px rgba(56,189,248,0.30);
        }
        .eye {
            position:absolute; right:10px; top:50%; transform:translateY(-50%);
            background:none; border:none; color:rgba(255,255,255,0.80);
            cursor:pointer; font-size:0.82rem; padding:4px;
        }
        .eye:hover { color:#fff; }

        /* ── SIGN IN BUTTON
             Width ≈ 83% of card  |  Height ≈ 9-10% of 35vh ≈ ~3vh ── */
        .signin {
            width:83%; flex-shrink:0;
            padding: clamp(9px,1.5vh,13px) 18px;
            background:linear-gradient(180deg, #7dd3fc 0%, #38bdf8 38%, #0ea5e9 52%, #0284c7 100%);
            border:1.5px solid rgba(255,255,255,0.85);
            border-radius:26px; color:#fff;
            font-size:clamp(0.82rem,1.3vh,1.02rem); font-weight:800;
            cursor:pointer; margin-top:2px;
            display:flex; align-items:center; justify-content:center; gap:10px;
            box-shadow:0 6px 20px rgba(2,132,199,0.45), inset 0 1px 0 rgba(255,255,255,0.80);
            text-shadow:0 1px 2px rgba(0,30,80,0.7);
            transition:all 0.22s; letter-spacing:0.4px;
        }
        .signin:hover {
            background:linear-gradient(180deg, #bae6fd 0%, #7dd3fc 38%, #38bdf8 52%, #0284c7 100%);
            transform:translateY(-2px); box-shadow:0 10px 26px rgba(2,132,199,0.65);
        }
        .arr {
            width:24px; height:24px; border-radius:50%;
            background:rgba(255,255,255,0.22); border:1px solid rgba(255,255,255,0.70);
            display:flex; align-items:center; justify-content:center; font-size:0.76rem;
        }

        /* Footer */
        .login-foot {
            width:83%; display:flex; justify-content:space-between; align-items:center;
            margin-top:clamp(6px,0.8vh,10px); font-size:clamp(0.60rem,0.95vh,0.74rem);
            font-weight:700; color:#fff; flex-shrink:0;
        }
        .login-foot label { display:flex; align-items:center; gap:4px; cursor:pointer; }
        .login-foot a     { color:rgba(255,255,255,0.82); text-decoration:none; }
        .login-foot a:hover { text-decoration:underline; }

        /* Bottom taskbar */
        .taskbar {
            width:100%; display:flex; justify-content:center; gap:clamp(16px,3vw,28px);
            padding-top:clamp(8px,1vh,12px); margin-top:clamp(6px,0.8vh,10px);
            border-top:1px solid rgba(255,255,255,0.18); flex-shrink:0;
        }
        .ti {
            display:flex; flex-direction:column; align-items:center; gap:2px;
            font-size:clamp(0.58rem,0.85vh,0.68rem); font-weight:700;
            color:rgba(255,255,255,0.88); text-decoration:none; cursor:pointer;
            transition:all 0.2s;
        }
        .ti:hover { color:#fff; transform:translateY(-2px); }
        .ti i { font-size:clamp(0.85rem,1.2vh,1.1rem); }

        /* Autoplay toast */
        .toast {
            position:fixed; bottom:18px; right:18px;
            background:rgba(255,255,255,0.16); backdrop-filter:blur(18px);
            border:1px solid rgba(255,255,255,0.65); border-radius:13px;
            padding:9px 16px; display:flex; align-items:center; gap:9px;
            font-size:0.82rem; font-weight:700; color:#fff; cursor:pointer; z-index:999;
            box-shadow:0 8px 24px rgba(0,50,130,0.26);
            animation:toastIn 0.5s cubic-bezier(0.34,1.56,0.64,1);
        }
        @@keyframes toastIn {
            from { transform:translateY(44px); opacity:0; }
            to   { transform:translateY(0);    opacity:1; }
        }

        /* ── MOBILE ── */
        @@media (max-width:899px) {
            .stage { padding:1vh 3vw 0.8vh; gap:1vh; }
            .top-row, .center-row { gap:2vw; }
            .weather, .music {
                width:48%;        /* side by side, 48% each */
                height:auto;      /* auto-height on mobile  */
            }
            .login-card {
                width:94vw;
                height:auto; max-height:62vh; overflow:hidden;
            }
            .login-body { padding:10px 5% 8px; }
            .fw, .signin, .login-foot { width:88%; }
        }

        @@media (max-width:480px) {
            .forecast    { display:none; }           /* hide forecast on tiny screens */
            .avatar      { width:44px; height:44px; }
            .login-title { font-size:1.25rem; }
        }
    </style>
</head>
<body>

<div class="bubbles">
    <div class="bbl"></div><div class="bbl"></div>
    <div class="bbl"></div><div class="bbl"></div>
    <div class="bbl"></div><div class="bbl"></div>
</div>

<audio id="bgAudio" src="/assets/welcome_music.mp3" preload="auto" loop></audio>

<div class="stage">

    <!-- ── TOP ROW ── -->
    <div class="top-row">

        <!-- WEATHER (41 vw × 13 vh) -->
        <div class="gp weather">
            <div class="bar">
                <div class="bar-left"><i class="fas fa-sun" style="color:#ffd43b;font-size:.75rem;"></i><span>Weather</span></div>
                <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
            </div>
            <div class="w-body">
                <div class="w-main">
                    <div class="sun">☀️</div>
                    <div>
                        <div class="w-temp" id="wTemp">24°</div>
                        <div class="w-desc" id="wDesc">Sunny</div>
                        <div class="w-feels" id="wFeels">Feels like 24°</div>
                    </div>
                </div>
                <div class="forecast">
                    <div class="fc"><span>Mon</span><i class="fas fa-sun fcs"></i><span>24°/18°</span></div>
                    <div class="fc"><span>Tue</span><i class="fas fa-sun fcs"></i><span>25°/19°</span></div>
                    <div class="fc"><span>Wed</span><i class="fas fa-sun fcs"></i><span>26°/19°</span></div>
                    <div class="fc"><span>Thu</span><i class="fas fa-sun fcs"></i><span>25°/18°</span></div>
                </div>
            </div>
        </div>

        <!-- MUSIC (41 vw × 13 vh) -->
        <div class="gp music">
            <div class="bar">
                <div class="bar-left"><i class="fas fa-music" style="color:#38bdf8;font-size:.75rem;"></i><span>Now Playing</span></div>
                <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
            </div>
            <div class="m-body">
                <div class="m-meta">
                    <img src="/assets/frutiger_aero_bg.jpg" class="album" alt="Art" />
                    <div style="flex:1;overflow:hidden;">
                        <div class="t-name">Ocean Breeze</div>
                        <div class="t-artist">Clear Skies</div>
                        <div class="t-album">A Brighter Tomorrow</div>
                    </div>
                </div>
                <div class="scrub-wrap">
                    <input type="range" class="scrub" id="scrubber" value="0" min="0" max="100"/>
                    <div class="t-labels">
                        <span id="curT">00:00</span>
                        <span id="totT">04:28</span>
                    </div>
                </div>
                <div class="m-ctrl">
                    <button class="cbtn"><i class="fas fa-random"></i></button>
                    <button class="cbtn"><i class="fas fa-step-backward"></i></button>
                    <button class="play-btn" id="btnPP"><i class="fas fa-play" id="pIcon"></i></button>
                    <button class="cbtn"><i class="fas fa-step-forward"></i></button>
                    <button class="cbtn" id="btnMute"><i class="fas fa-volume-up" id="vIcon"></i></button>
                </div>
            </div>
        </div>

    </div>

    <!-- ── CENTER ROW ── -->
    <div class="center-row">

        <!-- CLOCK (desktop only) -->
        <div class="gp clock-panel">
            <div class="globe"><i class="fas fa-globe-americas"></i></div>
            <div class="ck-time" id="ckTime">10:24 AM</div>
            <div class="ck-date" id="ckDate">Saturday, May 15, 2004</div>
            <div class="eco"><i class="fas fa-leaf"></i><span>A Cleaner<br>Brighter<br>Together</span></div>
        </div>

        <!-- LOGIN CARD (57 vw × 35 vh) -->
        <div class="gp login-card">
            <div class="bar">
                <div class="bar-left"><i class="fas fa-futbol" style="color:#38bdf8;font-size:.75rem;"></i><span>Match Registration</span></div>
                <div class="wbts"><span class="wb">─</span><span class="wb x">✕</span></div>
            </div>

            <div class="login-body">
                <!-- Avatar -->
                <div class="avatar" onclick="document.getElementById('photoInput').click()">
                    <i class="fas fa-user" id="avIcon"></i>
                    <img id="avImg" src="" style="display:none;" alt="Avatar"/>
                </div>

                <div class="login-title">Welcome</div>
                <div class="login-sub">Sign in to continue</div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="err-box">
                        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-controller="Home" asp-action="Submit" method="post"
                      enctype="multipart/form-data" id="regForm" style="width:100%;display:contents;">
                    @Html.AntiForgeryToken()
                    <input type="file" id="photoInput" name="profilePhoto" accept="image/*"
                           style="display:none;" onchange="prevAvatar(this)"/>
                    <input type="hidden" name="Status" value="جاي أكيد"/>
                    <input type="hidden" name="Note"   value=""/>

                    <div class="form-inner">
                        <!-- Phone Number -->
                        <div class="fw">
                            <i class="fas fa-phone-alt fi"></i>
                            <input type="tel" name="PhoneNumber" class="gf"
                                   placeholder="Phone Number" required autocomplete="tel"/>
                        </div>

                        <!-- Full Name -->
                        <div class="fw">
                            <i class="fas fa-user fi"></i>
                            <input type="text" name="FriendName" class="gf"
                                   placeholder="Full Name" required autocomplete="name"/>
                        </div>

                        <!-- Password -->
                        <div class="fw">
                            <i class="fas fa-lock fi"></i>
                            <input type="password" name="Password" id="passField" class="gf"
                                   style="padding-right:36px;"
                                   placeholder="Password" required minlength="4"
                                   autocomplete="current-password"/>
                            <button type="button" class="eye" onclick="togglePass()">
                                <i class="fas fa-eye" id="eyeIco"></i>
                            </button>
                        </div>

                        <!-- Sign In (83% width, 9-10% of 35vh height) -->
                        <button type="submit" class="signin" id="signBtn">
                            <span>Sign In</span>
                            <span class="arr"><i class="fas fa-arrow-right"></i></span>
                        </button>
                    </div>

                </form>

                <div class="login-foot">
                    <label>
                        <input type="checkbox" checked style="accent-color:#38bdf8;"/>
                        Remember me
                    </label>
                    <a asp-controller="Home" asp-action="Login">Forgot password?</a>
                </div>

                <div class="taskbar">
                    <div class="ti" onclick="toggleMusic()">
                        <i class="fas fa-globe"></i><span>Options</span>
                    </div>
                    <a asp-controller="Home" asp-action="Login" class="ti">
                        <i class="fas fa-cog"></i><span>Settings</span>
                    </a>
                    <div class="ti" onclick="location.href='/Home/Room'">
                        <i class="fas fa-power-off"></i><span>Shut down</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="toast" id="toast" onclick="startMusic()" style="display:none;">
    <i class="fas fa-volume-up" style="color:#38bdf8;font-size:1rem;"></i>
    <span>Tap to play music 🎵</span>
</div>

<script>
    // ── MUSIC ──
    const audio = document.getElementById('bgAudio');
    const pIcon = document.getElementById('pIcon');
    const vIcon = document.getElementById('vIcon');
    const scrub = document.getElementById('scrubber');
    const curT  = document.getElementById('curT');
    const totT  = document.getElementById('totT');
    const toast = document.getElementById('toast');
    let playing = false;

    function fmt(s){ if(isNaN(s))return'00:00'; const m=Math.floor(s/60),x=Math.floor(s%60); return(m<10?'0'+m:m)+':'+(x<10?'0'+x:x); }

    function startMusic(){
        audio.play().then(()=>{
            playing=true; pIcon.className='fas fa-pause'; toast.style.display='none';
        }).catch(()=>{ toast.style.display='flex'; });
    }
    function pauseMusic(){ audio.pause(); playing=false; pIcon.className='fas fa-play'; }
    function toggleMusic(){ playing?pauseMusic():startMusic(); }

    document.getElementById('btnPP').addEventListener('click', toggleMusic);

    window.addEventListener('DOMContentLoaded',()=>{
        startMusic();
        const u=()=>{ if(!playing)startMusic(); document.removeEventListener('click',u); document.removeEventListener('touchstart',u); document.removeEventListener('keydown',u); };
        document.addEventListener('click',u);
        document.addEventListener('touchstart',u);
        document.addEventListener('keydown',u);
    });

    audio.addEventListener('timeupdate',()=>{ if(audio.duration){ scrub.value=(audio.currentTime/audio.duration)*100; curT.textContent=fmt(audio.currentTime); totT.textContent=fmt(audio.duration); } });
    audio.addEventListener('loadedmetadata',()=>{ totT.textContent=fmt(audio.duration); });
    scrub.addEventListener('input',()=>{ if(audio.duration)audio.currentTime=(scrub.value/100)*audio.duration; });
    document.getElementById('btnMute').addEventListener('click',()=>{ audio.muted=!audio.muted; vIcon.className=audio.muted?'fas fa-volume-mute':'fas fa-volume-up'; });

    // ── CLOCK ──
    function tick(){
        const n=new Date(); let h=n.getHours(),m=n.getMinutes(),ap=h>=12?'PM':'AM';
        h=h%12||12;
        document.getElementById('ckTime').textContent=h+':'+(m<10?'0'+m:m)+' '+ap;
        const D=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
        const M=['January','February','March','April','May','June','July','August','September','October','November','December'];
        document.getElementById('ckDate').textContent=D[n.getDay()]+', '+M[n.getMonth()]+' '+n.getDate()+', '+n.getFullYear();
    }
    setInterval(tick,1000); tick();

    // ── WEATHER ──
    fetch('https://api.open-meteo.com/v1/forecast?latitude=30.0444&longitude=31.2357&current_weather=true')
        .then(r=>r.json()).then(d=>{ if(d&&d.current_weather){ const t=Math.round(d.current_weather.temperature); document.getElementById('wTemp').textContent=t+'°'; document.getElementById('wFeels').textContent='Feels like '+t+'°'; } }).catch(()=>{});

    // ── FORM ──
    function togglePass(){ const f=document.getElementById('passField'),i=document.getElementById('eyeIco'); f.type=f.type==='password'?'text':'password'; i.className=f.type==='password'?'fas fa-eye':'fas fa-eye-slash'; }
    function prevAvatar(inp){ if(inp.files&&inp.files[0]){ const r=new FileReader(); r.onload=e=>{ document.getElementById('avIcon').style.display='none'; const img=document.getElementById('avImg'); img.src=e.target.result; img.style.display='block'; }; r.readAsDataURL(inp.files[0]); } }
    document.getElementById('regForm').addEventListener('submit',()=>{ const b=document.getElementById('signBtn'); b.innerHTML='<span>Signing in...</span><i class="fas fa-spinner fa-spin"></i>'; b.style.opacity='0.85'; });
</script>
</body>
</html>