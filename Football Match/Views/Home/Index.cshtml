@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>⚽ Match Registration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            background: url('/assets/frutiger_aero_bg.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #fff;
            overflow-x: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 16px 40px;
        }

        /* ===== FLOATING BUBBLES ===== */
        .bubbles-layer {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 1;
        }

        .water-bubble {
            position: absolute;
            bottom: -90px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 28%,
                rgba(255,255,255,0.95) 0%,
                rgba(186,230,253,0.5) 40%,
                rgba(56,189,248,0.15) 75%,
                transparent 100%);
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: inset 0 0 10px rgba(255,255,255,0.6),
                        0 0 12px rgba(255,255,255,0.3);
            animation: riseBubble linear infinite;
        }

        .water-bubble:nth-child(1)  { left: 5%;  width: 38px;  height: 38px;  animation-duration: 20s; animation-delay: 0s; }
        .water-bubble:nth-child(2)  { left: 18%; width: 65px;  height: 65px;  animation-duration: 26s; animation-delay: 4s; }
        .water-bubble:nth-child(3)  { left: 40%; width: 28px;  height: 28px;  animation-duration: 18s; animation-delay: 2s; }
        .water-bubble:nth-child(4)  { left: 62%; width: 55px;  height: 55px;  animation-duration: 22s; animation-delay: 6s; }
        .water-bubble:nth-child(5)  { left: 78%; width: 42px;  height: 42px;  animation-duration: 17s; animation-delay: 1s; }
        .water-bubble:nth-child(6)  { left: 90%; width: 70px;  height: 70px;  animation-duration: 28s; animation-delay: 9s; }
        .water-bubble:nth-child(7)  { left: 30%; width: 22px;  height: 22px;  animation-duration: 14s; animation-delay: 3s; }
        .water-bubble:nth-child(8)  { left: 55%; width: 48px;  height: 48px;  animation-duration: 24s; animation-delay: 7s; }

        @@keyframes riseBubble {
            0%   { transform: translateY(0) scale(0.8);  opacity: 0; }
            8%   { opacity: 0.9; }
            88%  { opacity: 0.8; }
            100% { transform: translateY(-108vh) scale(1.2); opacity: 0; }
        }

        /* ===== STAGE LAYOUT ===== */
        .aero-stage {
            width: 100%;
            max-width: 1200px;
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .aero-top-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 16px;
            width: 100%;
        }

        .aero-center-row {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            position: relative;
            width: 100%;
            gap: 20px;
        }

        /* ===== CRYSTAL GLASS PANEL — KEY STYLE ===== */
        .glass-panel {
            background: rgba(200, 235, 255, 0.08);
            backdrop-filter: blur(22px) saturate(160%);
            -webkit-backdrop-filter: blur(22px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.55);
            border-radius: 22px;
            box-shadow:
                0 8px 32px rgba(0, 60, 140, 0.18),
                inset 0 1.5px 0 rgba(255,255,255,0.85),
                inset 0 -1px 0 rgba(255,255,255,0.15);
            position: relative;
            overflow: hidden;
        }

        /* Top specular curve — gives the bubble 3D look */
        .glass-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 38%;
            background: linear-gradient(180deg,
                rgba(255,255,255,0.38) 0%,
                rgba(255,255,255,0.06) 75%,
                transparent 100%);
            border-radius: 22px 22px 55% 55% / 22px 22px 20% 20%;
            pointer-events: none;
            z-index: 2;
        }

        /* Window title-bar */
        .panel-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 14px;
            border-bottom: 1px solid rgba(255,255,255,0.22);
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255,255,255,0.95);
            text-shadow: 0 1px 3px rgba(0,30,80,0.5);
            user-select: none;
            position: relative;
            z-index: 3;
        }

        .panel-bar-title {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .win-btns {
            display: flex;
            gap: 5px;
        }

        .win-btn {
            width: 16px;
            height: 16px;
            border-radius: 3px;
            border: 1px solid rgba(255,255,255,0.5);
            background: rgba(255,255,255,0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            color: #fff;
            cursor: pointer;
            line-height: 1;
        }
        .win-btn:hover { background: rgba(255,255,255,0.55); }
        .win-btn.x:hover { background: #ef4444; }

        /* ===== WEATHER PANEL ===== */
        .weather-panel { width: 245px; flex-shrink: 0; }

        .weather-body {
            padding: 14px 16px 16px;
            position: relative;
            z-index: 3;
        }

        .weather-main {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 12px;
        }

        .sun-ball {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #fff9c4, #ffd43b 55%, #f59f00);
            box-shadow: 0 0 20px rgba(255,210,0,0.85), 0 0 40px rgba(255,180,0,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .w-temp { font-size: 2.5rem; font-weight: 800; line-height: 1; text-shadow: 0 2px 6px rgba(0,30,80,0.5); }
        .w-desc { font-size: 0.9rem; font-weight: 700; color: #e0f2fe; }
        .w-feels { font-size: 0.72rem; color: rgba(224,242,254,0.8); }

        .forecast-strip {
            display: flex;
            justify-content: space-between;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.28);
            border-radius: 12px;
            padding: 8px 10px;
            font-size: 0.68rem;
            font-weight: 700;
            color: #fff;
        }

        .fc-col { display: flex; flex-direction: column; align-items: center; gap: 3px; }
        .fc-sun { color: #fcc419; font-size: 0.85rem; }

        /* ===== MUSIC PANEL ===== */
        .music-panel { width: 325px; flex-shrink: 0; }

        .music-body {
            padding: 14px 16px;
            position: relative;
            z-index: 3;
        }

        .music-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .album-thumb {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            object-fit: cover;
            border: 1.5px solid rgba(255,255,255,0.7);
            box-shadow: 0 4px 14px rgba(0,50,120,0.3);
            flex-shrink: 0;
        }

        .track-info { flex: 1; overflow: hidden; }
        .track-name {
            font-size: 0.95rem;
            font-weight: 800;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-shadow: 0 1px 3px rgba(0,30,80,0.6);
        }
        .track-artist { font-size: 0.75rem; font-weight: 600; color: #bae6fd; }
        .track-album  { font-size: 0.67rem; color: rgba(224,242,254,0.75); }

        /* scrubber */
        .scrubber-wrap { margin-bottom: 10px; }
        .time-range {
            width: 100%;
            height: 5px;
            -webkit-appearance: none;
            appearance: none;
            background: rgba(255,255,255,0.3);
            border-radius: 3px;
            outline: none;
            cursor: pointer;
        }
        .time-range::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px; height: 14px;
            border-radius: 50%;
            background: #38bdf8;
            border: 2px solid #fff;
            box-shadow: 0 0 8px rgba(56,189,248,0.9);
            cursor: pointer;
        }
        .time-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.67rem;
            font-weight: 700;
            color: #fff;
            margin-top: 3px;
            font-family: Consolas, monospace;
        }

        .player-btns {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 4px;
        }

        .ctrl-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 0.9rem;
            cursor: pointer;
            padding: 4px;
            transition: all 0.15s;
            text-shadow: 0 1px 3px rgba(0,30,80,0.5);
        }
        .ctrl-btn:hover { color: #38bdf8; transform: scale(1.15); }

        .play-bubble {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #7dd3fc, #0284c7 60%, #0369a1);
            border: 2px solid rgba(255,255,255,0.9);
            box-shadow: 0 0 16px rgba(2,132,199,0.7), inset 0 1px 0 rgba(255,255,255,0.8);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .play-bubble:hover { transform: scale(1.1); box-shadow: 0 0 24px rgba(2,132,199,0.9); }

        /* ===== CLOCK PANEL ===== */
        .clock-panel {
            width: 170px;
            text-align: center;
            padding: 18px 14px;
            flex-shrink: 0;
            display: none;
        }
        @@media (min-width: 1024px) { .clock-panel { display: block; } }

        .globe-icon {
            font-size: 2.5rem;
            color: #38bdf8;
            filter: drop-shadow(0 0 12px rgba(56,189,248,0.8));
            margin-bottom: 8px;
        }
        .clock-time {
            font-size: 1.4rem;
            font-weight: 800;
            text-shadow: 0 1px 4px rgba(0,30,80,0.6);
        }
        .clock-date {
            font-size: 0.72rem;
            color: rgba(224,242,254,0.9);
            font-weight: 600;
            margin-top: 4px;
        }
        .eco-tag {
            margin-top: 10px;
            font-size: 0.64rem;
            color: #a7f3d0;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            background: rgba(16,185,129,0.2);
            border: 1px solid rgba(16,185,129,0.35);
            border-radius: 8px;
            padding: 3px 7px;
        }

        /* ===== LOGIN / REGISTRATION PANEL ===== */
        .login-panel {
            width: 100%;
            max-width: 430px;
            position: relative;
            z-index: 3;
        }

        .login-body {
            padding: 28px 30px 24px;
            text-align: center;
            position: relative;
            z-index: 3;
        }

        /* Avatar circle */
        .avatar-ring {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            margin: 0 auto 14px;
            background: radial-gradient(circle at 38% 32%,
                rgba(255,255,255,0.9) 0%,
                rgba(147,210,255,0.65) 55%,
                rgba(2,132,199,0.7) 100%);
            border: 2.5px solid rgba(255,255,255,0.9);
            box-shadow: 0 0 28px rgba(56,189,248,0.55),
                        inset 0 2px 4px rgba(255,255,255,0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
            transition: all 0.25s;
        }
        .avatar-ring:hover { transform: scale(1.05); }
        .avatar-ring i { font-size: 2.8rem; color: #0369a1; }
        .avatar-ring img { width: 100%; height: 100%; object-fit: cover; }

        .login-title {
            font-size: 1.9rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 3px;
            text-shadow: 0 2px 6px rgba(0,30,80,0.6);
        }
        .login-sub {
            font-size: 0.86rem;
            color: rgba(224,242,254,0.9);
            font-weight: 600;
            margin-bottom: 22px;
        }

        /* Input fields */
        .field-wrap {
            position: relative;
            margin-bottom: 12px;
            text-align: left;
        }

        .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #0284c7;
            font-size: 0.9rem;
            pointer-events: none;
            z-index: 1;
        }

        .glass-field {
            width: 100%;
            background: rgba(255,255,255,0.55);
            backdrop-filter: blur(6px);
            border: 1.5px solid rgba(255,255,255,0.75);
            border-radius: 12px;
            padding: 11px 42px 11px 40px;
            font-size: 0.93rem;
            font-weight: 600;
            color: #034574;
            outline: none;
            transition: all 0.2s;
            box-shadow: inset 0 1px 3px rgba(0,50,120,0.1);
        }
        .glass-field::placeholder { color: rgba(3,69,116,0.5); font-weight: 500; }
        .glass-field:focus {
            background: rgba(255,255,255,0.72);
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,0.3);
        }

        .eye-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #0284c7;
            cursor: pointer;
            font-size: 0.9rem;
            padding: 4px;
        }
        .eye-btn:hover { color: #0ea5e9; }

        /* Error box */
        .error-box {
            background: rgba(239,68,68,0.25);
            border: 1px solid rgba(239,68,68,0.65);
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 14px;
            font-size: 0.82rem;
            font-weight: 700;
            color: #fff;
            text-align: left;
        }

        /* Sign In button */
        .signin-btn {
            width: 100%;
            padding: 13px 20px;
            background: linear-gradient(180deg,
                #7dd3fc 0%, #38bdf8 40%,
                #0ea5e9 50%, #0284c7 100%);
            border: 2px solid rgba(255,255,255,0.9);
            border-radius: 30px;
            color: #fff;
            font-size: 1.08rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 8px;
            box-shadow:
                0 8px 24px rgba(2,132,199,0.5),
                inset 0 1px 0 rgba(255,255,255,0.85),
                inset 0 -2px 4px rgba(0,40,90,0.35);
            text-shadow: 0 1px 2px rgba(0,30,80,0.7);
            transition: all 0.22s;
            letter-spacing: 0.5px;
        }
        .signin-btn:hover {
            background: linear-gradient(180deg,
                #bae6fd 0%, #7dd3fc 40%,
                #38bdf8 50%, #0284c7 100%);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(2,132,199,0.7);
        }

        .arrow-circle {
            width: 28px; height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            border: 1.5px solid rgba(255,255,255,0.8);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.85rem;
        }

        /* Footer */
        .login-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            font-size: 0.79rem;
            font-weight: 700;
            color: #fff;
        }

        .login-footer label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .login-footer a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
        }
        .login-footer a:hover { text-decoration: underline; color: #fff; }

        /* Bottom taskbar */
        .bottom-bar {
            display: flex;
            justify-content: center;
            gap: 32px;
            padding-top: 18px;
            margin-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.22);
        }

        .task-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-size: 0.72rem;
            font-weight: 700;
            color: rgba(255,255,255,0.9);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .task-item:hover { color: #fff; transform: translateY(-2px); }
        .task-item i { font-size: 1.2rem; }

        /* Autoplay toast */
        .autoplay-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(18px);
            border: 1.5px solid rgba(255,255,255,0.75);
            border-radius: 16px;
            padding: 11px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.87rem;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            z-index: 1000;
            box-shadow: 0 10px 30px rgba(0,50,130,0.3);
            animation: slideUp 0.5s cubic-bezier(0.34,1.56,0.64,1);
        }
        @@keyframes slideUp {
            from { transform: translateY(50px); opacity: 0; }
            to   { transform: translateY(0);    opacity: 1; }
        }

        /* Mobile */
        @@media (max-width: 991px) {
            .aero-top-row { flex-direction: column; align-items: stretch; }
            .weather-panel, .music-panel { width: 100%; }
            .login-panel { max-width: 100%; }
        }

        @@media (max-width: 600px) {
            .login-body { padding: 22px 20px 20px; }
        }
    </style>
</head>
<body>

    <!-- Floating Bubbles -->
    <div class="bubbles-layer">
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
        <div class="water-bubble"></div>
    </div>

    <!-- Hidden Audio -->
    <audio id="bgMusic" src="/assets/welcome_music.mp3" preload="auto" loop></audio>

    <div class="aero-stage">

        <!-- TOP ROW: Weather (left) + Music (right) -->
        <div class="aero-top-row">

            <!-- WEATHER -->
            <div class="glass-panel weather-panel">
                <div class="panel-bar">
                    <div class="panel-bar-title">
                        <i class="fas fa-sun" style="color:#ffd43b;"></i>
                        <span>Weather</span>
                    </div>
                    <div class="win-btns">
                        <span class="win-btn">─</span>
                        <span class="win-btn x">✕</span>
                    </div>
                </div>
                <div class="weather-body">
                    <div class="weather-main">
                        <div class="sun-ball">☀️</div>
                        <div>
                            <div class="w-temp" id="wTemp">24°</div>
                            <div class="w-desc" id="wDesc">Sunny</div>
                            <div class="w-feels" id="wFeels">Feels like 24°</div>
                        </div>
                    </div>
                    <div class="forecast-strip">
                        <div class="fc-col"><span>Mon</span><i class="fas fa-sun fc-sun"></i><span>24°/18°</span></div>
                        <div class="fc-col"><span>Tue</span><i class="fas fa-sun fc-sun"></i><span>25°/19°</span></div>
                        <div class="fc-col"><span>Wed</span><i class="fas fa-sun fc-sun"></i><span>26°/19°</span></div>
                        <div class="fc-col"><span>Thu</span><i class="fas fa-sun fc-sun"></i><span>25°/18°</span></div>
                    </div>
                </div>
            </div>

            <!-- MUSIC PLAYER -->
            <div class="glass-panel music-panel">
                <div class="panel-bar">
                    <div class="panel-bar-title">
                        <i class="fas fa-music" style="color:#38bdf8;"></i>
                        <span>Now Playing</span>
                    </div>
                    <div class="win-btns">
                        <span class="win-btn">─</span>
                        <span class="win-btn x">✕</span>
                    </div>
                </div>
                <div class="music-body">
                    <div class="music-meta">
                        <img src="/assets/frutiger_aero_bg.jpg" class="album-thumb" alt="Album Art" />
                        <div class="track-info">
                            <div class="track-name">Ocean Breeze</div>
                            <div class="track-artist">Clear Skies</div>
                            <div class="track-album">A Brighter Tomorrow</div>
                        </div>
                    </div>
                    <div class="scrubber-wrap">
                        <input type="range" class="time-range" id="musicScrubber" value="0" min="0" max="100" />
                        <div class="time-labels">
                            <span id="curTime">01:17</span>
                            <span id="totTime">04:28</span>
                        </div>
                    </div>
                    <div class="player-btns">
                        <button class="ctrl-btn" title="Shuffle"><i class="fas fa-random"></i></button>
                        <button class="ctrl-btn" title="Previous"><i class="fas fa-step-backward"></i></button>
                        <button class="play-bubble" id="btnPlayPause" title="Play / Pause">
                            <i class="fas fa-play" id="playIcon"></i>
                        </button>
                        <button class="ctrl-btn" title="Next"><i class="fas fa-step-forward"></i></button>
                        <button class="ctrl-btn" id="btnMute" title="Mute"><i class="fas fa-volume-up" id="volIcon"></i></button>
                    </div>
                </div>
            </div>

        </div>

        <!-- CENTER ROW: Clock (left on desktop) + Login Card (center) -->
        <div class="aero-center-row">

            <!-- CLOCK -->
            <div class="glass-panel clock-panel">
                <div class="globe-icon"><i class="fas fa-globe-americas"></i></div>
                <div class="clock-time" id="clockTime">10:24 AM</div>
                <div class="clock-date" id="clockDate">Saturday, May 15, 2004</div>
                <div class="eco-tag">
                    <i class="fas fa-leaf"></i>
                    <span>A Cleaner<br>Brighter<br>Together</span>
                </div>
            </div>

            <!-- LOGIN CARD -->
            <div class="glass-panel login-panel">
                <div class="panel-bar">
                    <div class="panel-bar-title">
                        <i class="fas fa-futbol" style="color:#38bdf8;"></i>
                        <span>Match Registration</span>
                    </div>
                    <div class="win-btns">
                        <span class="win-btn">─</span>
                        <span class="win-btn x">✕</span>
                    </div>
                </div>

                <div class="login-body">

                    <!-- Avatar -->
                    <div class="avatar-ring" onclick="document.getElementById('profilePhoto').click()" title="Upload photo (optional)">
                        <i class="fas fa-user" id="avatarIcon"></i>
                        <img id="avatarImg" src="" style="display:none;" alt="Avatar" />
                    </div>

                    <div class="login-title">Welcome</div>
                    <div class="login-sub">Sign in to continue</div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="error-box">
                            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Submit" method="post" enctype="multipart/form-data" id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="file" id="profilePhoto" name="profilePhoto" accept="image/*"
                               style="display:none;" onchange="previewAvatar(this)" />

                        <!-- Hidden fields to satisfy model (defaults) -->
                        <input type="hidden" name="Status" value="جاي أكيد" />
                        <input type="hidden" name="Note" value="" />
                        <input type="hidden" name="FriendName" id="friendNameHidden" value="" />

                        <!-- Phone / Username -->
                        <div class="field-wrap">
                            <i class="fas fa-user field-icon"></i>
                            <input type="tel" name="PhoneNumber" id="phoneInput"
                                   class="glass-field"
                                   placeholder="Phone Number"
                                   required
                                   autocomplete="tel"
                                   oninput="syncFriendName(this.value)" />
                        </div>

                        <!-- Password -->
                        <div class="field-wrap">
                            <i class="fas fa-lock field-icon"></i>
                            <input type="password" name="Password" id="passInput"
                                   class="glass-field"
                                   placeholder="Password"
                                   required minlength="4"
                                   autocomplete="current-password" />
                            <button type="button" class="eye-btn" onclick="togglePass()">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>

                        <!-- Sign In -->
                        <button type="submit" class="signin-btn" id="submitBtn">
                            <span>Sign In</span>
                            <span class="arrow-circle"><i class="fas fa-arrow-right"></i></span>
                        </button>

                    </form>

                    <!-- Footer -->
                    <div class="login-footer">
                        <label>
                            <input type="checkbox" checked style="accent-color:#38bdf8;" />
                            Remember me
                        </label>
                        <a asp-controller="Home" asp-action="Login">Forgot password?</a>
                    </div>

                    <!-- Bottom taskbar -->
                    <div class="bottom-bar">
                        <div class="task-item" onclick="toggleMusic()">
                            <i class="fas fa-globe"></i>
                            <span>Options</span>
                        </div>
                        <a asp-controller="Home" asp-action="Login" class="task-item">
                            <i class="fas fa-cog"></i>
                            <span>Settings</span>
                        </a>
                        <div class="task-item" onclick="window.location='/Home/Room'">
                            <i class="fas fa-power-off"></i>
                            <span>Shut down</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- Autoplay toast -->
    <div class="autoplay-toast" id="autoplayToast" onclick="startFromToast()" style="display:none;">
        <i class="fas fa-volume-up fa-lg" style="color:#38bdf8;"></i>
        <span>Click to play music 🎵</span>
    </div>

    <script>
        // ========== MUSIC PLAYER ==========
        const audio      = document.getElementById('bgMusic');
        const btnPP      = document.getElementById('btnPlayPause');
        const playIcon   = document.getElementById('playIcon');
        const scrubber   = document.getElementById('musicScrubber');
        const curTimeEl  = document.getElementById('curTime');
        const totTimeEl  = document.getElementById('totTime');
        const volIcon    = document.getElementById('volIcon');
        const toast      = document.getElementById('autoplayToast');

        let playing = false;

        function fmt(s) {
            if (isNaN(s)) return '00:00';
            const m = Math.floor(s / 60), sec = Math.floor(s % 60);
            return (m < 10 ? '0'+m : m) + ':' + (sec < 10 ? '0'+sec : sec);
        }

        function playAudio() {
            audio.play().then(() => {
                playing = true;
                playIcon.className = 'fas fa-pause';
                if (toast) toast.style.display = 'none';
            }).catch(() => {
                if (toast) toast.style.display = 'flex';
            });
        }

        function pauseAudio() {
            audio.pause();
            playing = false;
            playIcon.className = 'fas fa-play';
        }

        btnPP.addEventListener('click', () => playing ? pauseAudio() : playAudio());

        function startFromToast() { playAudio(); toast.style.display = 'none'; }
        function toggleMusic()    { playing ? pauseAudio() : playAudio(); }

        // Autoplay on load + first interaction unlock
        window.addEventListener('DOMContentLoaded', () => {
            playAudio();
            const unlock = () => { if (!playing) playAudio(); document.removeEventListener('click', unlock); document.removeEventListener('touchstart', unlock); document.removeEventListener('keydown', unlock); };
            document.addEventListener('click', unlock);
            document.addEventListener('touchstart', unlock);
            document.addEventListener('keydown', unlock);
        });

        audio.addEventListener('timeupdate', () => {
            if (audio.duration) {
                scrubber.value = (audio.currentTime / audio.duration) * 100;
                curTimeEl.textContent = fmt(audio.currentTime);
                totTimeEl.textContent = fmt(audio.duration);
            }
        });

        audio.addEventListener('loadedmetadata', () => { totTimeEl.textContent = fmt(audio.duration); });

        scrubber.addEventListener('input', () => {
            if (audio.duration) audio.currentTime = (scrubber.value / 100) * audio.duration;
        });

        document.getElementById('btnMute').addEventListener('click', () => {
            audio.muted = !audio.muted;
            volIcon.className = audio.muted ? 'fas fa-volume-mute' : 'fas fa-volume-up';
        });

        // ========== LIVE CLOCK ==========
        function updateClock() {
            const n = new Date();
            let h = n.getHours(), m = n.getMinutes(), ap = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            document.getElementById('clockTime').textContent =
                h + ':' + (m < 10 ? '0'+m : m) + ' ' + ap;
            const days   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            document.getElementById('clockDate').textContent =
                days[n.getDay()] + ', ' + months[n.getMonth()] + ' ' + n.getDate() + ', ' + n.getFullYear();
        }
        setInterval(updateClock, 1000);
        updateClock();

        // ========== LIVE WEATHER ==========
        fetch('https://api.open-meteo.com/v1/forecast?latitude=30.0444&longitude=31.2357&current_weather=true')
            .then(r => r.json())
            .then(d => {
                if (d && d.current_weather) {
                    const t = Math.round(d.current_weather.temperature);
                    document.getElementById('wTemp').textContent  = t + '°';
                    document.getElementById('wFeels').textContent = 'Feels like ' + t + '°';
                }
            }).catch(() => {});

        // ========== FORM ==========
        function syncFriendName(val) {
            document.getElementById('friendNameHidden').value = val;
        }

        function togglePass() {
            const inp = document.getElementById('passInput');
            const ico = document.getElementById('eyeIcon');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            ico.className = inp.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }

        function previewAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('avatarIcon').style.display = 'none';
                    const img = document.getElementById('avatarImg');
                    img.src = e.target.result;
                    img.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.getElementById('loginForm').addEventListener('submit', () => {
            const btn = document.getElementById('submitBtn');
            btn.innerHTML = '<span>Signing in...</span> <i class="fas fa-spinner fa-spin"></i>';
            btn.style.opacity = '0.85';
        });
    </script>
</body>
</html>