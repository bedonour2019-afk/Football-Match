@model Football_Match.Models.Attendance
@{
    Layout = null;
    int currentId = ViewBag.CurrentAttendanceId ?? 0;
    bool isAdminUser = ViewBag.IsAdmin ?? false;
    bool isOwn = ViewBag.IsOwnProfile ?? false;
    var posts = ViewBag.Posts as IEnumerable<Football_Match.Models.Post> ?? new List<Football_Match.Models.Post>();
    bool isMvp = Model.IsMVP;
    string displayName = Model.Nickname ?? Model.FriendName;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>👤 @displayName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #0d0d1a;
            color: #fff;
            font-family: "Segoe UI", Tahoma, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        /* ===== COVER ===== */
        .cover-section {
            position: relative;
            height: 200px;
            background: linear-gradient(135deg, #1e1b4b, #312e81, #0d0d1a);
            overflow: hidden;
        }

        .cover-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cover-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 50%, #0d0d1a);
        }

        /* MVP golden cover */
        @if (isMvp)
        {
            <text>
            .cover-section {
                background: linear-gradient(135deg, #78350f, #92400e, #b45309, #0d0d1a);
            }
            </text>
        }

        /* ===== BACK BTN ===== */
        .back-btn-float {
            position: absolute;
            top: 14px;
            right: 14px;
            background: rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 10px;
            color: #fff;
            padding: 7px 14px;
            font-size: 0.82rem;
            text-decoration: none;
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 5;
            transition: all 0.2s;
        }

        .back-btn-float:hover { color: #fff; background: rgba(0,0,0,0.6); }

        /* ===== AVATAR ===== */
        .profile-avatar-wrap {
            position: relative;
            display: inline-block;
        }

        .profile-avatar {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid @(isMvp ? "#f59e0b" : "rgba(255,255,255,0.2)");
            box-shadow: @(isMvp ? "0 0 20px rgba(245,158,11,0.5)" : "none");
        }

        .profile-avatar-ph {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            background: @(isMvp ? "linear-gradient(135deg,#92400e,#b45309)" : "rgba(124,58,237,0.3)");
            color: @(isMvp ? "#f59e0b" : "#a855f7");
            border: 3px solid @(isMvp ? "#f59e0b" : "rgba(124,58,237,0.4)");
            box-shadow: @(isMvp ? "0 0 20px rgba(245,158,11,0.4)" : "none");
        }

        .mvp-crown-badge {
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1.2rem;
            filter: drop-shadow(0 0 8px rgba(245,158,11,0.8));
        }

        /* ===== PROFILE INFO ===== */
        .profile-info-section {
            padding: 0 20px 0;
            margin-top: -44px;
            position: relative;
            z-index: 2;
        }

        .profile-top-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .profile-name {
            font-size: 1.3rem;
            font-weight: 900;
            margin-top: 8px;
            color: @(isMvp ? "#f59e0b" : "#fff");
            text-shadow: @(isMvp ? "0 0 20px rgba(245,158,11,0.4)" : "none");
        }

        .profile-real-name {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.45);
            margin-top: 2px;
        }

        .profile-bio {
            font-size: 0.88rem;
            color: rgba(255,255,255,0.65);
            margin-top: 8px;
            line-height: 1.5;
        }

        /* Stats Row */
        .profile-stats {
            display: flex;
            gap: 20px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,0.07);
            flex-wrap: wrap;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 1.05rem;
            font-weight: 800;
            color: #fff;
        }

        .stat-label {
            font-size: 0.68rem;
            color: rgba(255,255,255,0.4);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Badges Row */
        .badges-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 12px;
        }

        .badge-item {
            display: flex;
            align-items: center;
            gap: 4px;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .badge-mvp {
            background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(234,179,8,0.1));
            border: 1px solid rgba(245,158,11,0.4);
            color: #f59e0b;
        }

        .badge-rating {
            background: rgba(124,58,237,0.15);
            border: 1px solid rgba(124,58,237,0.3);
            color: #a855f7;
        }

        .badge-position {
            background: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.25);
            color: #22c55e;
        }

        .badge-tag {
            background: rgba(245,158,11,0.1);
            border: 1px solid rgba(245,158,11,0.25);
            color: #f59e0b;
        }

        /* Action Buttons */
        .action-btns {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            text-decoration: none;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            color: #fff;
        }

        .btn-secondary-custom {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            color: rgba(255,255,255,0.85);
        }

        .btn-primary-custom:hover, .btn-secondary-custom:hover {
            transform: scale(1.03);
            color: #fff;
        }

        /* ===== POSTS SECTION ===== */
        .posts-section {
            max-width: 640px;
            margin: 24px auto 0;
            padding: 0 16px;
        }

        .section-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.35);
            margin-bottom: 14px;
            padding-right: 4px;
        }

        .post-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
            transition: all 0.2s;
        }

        .post-card.admin-post {
            background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(255,255,255,0.03));
            border-color: rgba(245,158,11,0.3);
            box-shadow: 0 0 20px rgba(245,158,11,0.08);
        }

        .post-card img, .post-card video {
            width: 100%;
            border-radius: 10px;
            margin-top: 10px;
            max-height: 320px;
            object-fit: cover;
        }

        .post-text {
            font-size: 0.9rem;
            line-height: 1.6;
            color: rgba(255,255,255,0.85);
        }

        .post-meta {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.35);
            margin-top: 8px;
        }

        .post-reactions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .reaction-chip {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.78rem;
            cursor: pointer;
        }

        /* MVP golden background */
        @if (isMvp)
        {
            <text>
            .profile-info-section::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at top, rgba(245,158,11,0.06) 0%, transparent 70%);
                pointer-events: none;
                z-index: -1;
            }
            </text>
        }

        /* Edit Panel */
        .edit-panel {
            background: rgba(124,58,237,0.08);
            border: 1px solid rgba(124,58,237,0.2);
            border-radius: 16px;
            padding: 16px;
            margin: 16px 20px;
        }

        .edit-panel-title {
            font-size: 0.8rem;
            color: #a855f7;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .edit-input {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            padding: 9px 12px;
            font-size: 0.88rem;
            margin-bottom: 10px;
        }

        .edit-input::placeholder { color: rgba(255,255,255,0.28); }

        .save-btn {
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            border: none;
            border-radius: 10px;
            color: #fff;
            padding: 9px 20px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: all 0.2s;
        }

        /* Admin Rating Panel */
        .admin-rating-panel {
            background: rgba(245,158,11,0.07);
            border: 1px solid rgba(245,158,11,0.2);
            border-radius: 12px;
            padding: 12px 16px;
            margin: 0 20px 16px;
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .admin-rating-label {
            font-size: 0.8rem;
            color: #f59e0b;
            font-weight: 700;
        }

        .toast-msg {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(124,58,237,0.9);
            color: #fff;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 600;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
            z-index: 9999;
        }

        .toast-msg.show { opacity: 1; }

        /* Lightbox */
        .lightbox { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.92); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(5px); }
        .lightbox.show { display:flex; }
        .lightbox img { max-width:90vw; max-height:90vh; border-radius:12px; }
        .lightbox-close { position:absolute; top:20px; right:20px; background:rgba(255,255,255,0.15); border:none; border-radius:50%; width:40px; height:40px; color:#fff; font-size:1.2rem; cursor:pointer; }
    </style>
</head>
<body>
    <div class="toast-msg" id="toastMsg"></div>

    <!-- Cover -->
    <div class="cover-section">
        @if (!string.IsNullOrEmpty(Model.CoverPhotoPath))
        {
            <img class="cover-img" src="@Model.CoverPhotoPath" alt="غلاف" />
        }
        <div class="cover-overlay"></div>
        <a href="/Home/Room" class="back-btn-float"><i class="fas fa-arrow-right"></i> الغرفة</a>
        @if (isOwn)
        {
            <label for="coverInput" style="position:absolute;bottom:12px;left:12px;background:rgba(0,0,0,0.5);border:1px solid rgba(255,255,255,0.2);border-radius:8px;padding:5px 10px;font-size:0.75rem;cursor:pointer;z-index:3;color:rgba(255,255,255,0.85);backdrop-filter:blur(6px);">
                <i class="fas fa-camera me-1"></i> تغيير الغلاف
            </label>
            <input type="file" id="coverInput" accept="image/*" style="display:none;" onchange="uploadCover(this)" />
        }
    </div>

    <!-- Profile Info -->
    <div class="profile-info-section">
        <div class="profile-top-row">
            <div class="profile-avatar-wrap">
                @if (isMvp)
                {
                    <div class="mvp-crown-badge">👑</div>
                }
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img class="profile-avatar" src="@Model.ProfilePicturePath" alt="@Model.FriendName" />
                }
                else
                {
                    <div class="profile-avatar-ph">@(Model.FriendName.Length > 0 ? Model.FriendName.Substring(0,1).ToUpper() : "?")</div>
                }
            </div>
            <div class="action-btns" style="margin-top:0;">
                @if (!isOwn)
                {
                    <button class="action-btn btn-primary-custom" onclick="sendMessage()">
                        <i class="fas fa-paper-plane"></i> إرسال رسالة
                    </button>
                }
                @if (isOwn)
                {
                    <button class="action-btn btn-secondary-custom" onclick="toggleEditPanel()">
                        <i class="fas fa-edit"></i> تعديل البروفايل
                    </button>
                }
                <a href="/Teams/Index" class="action-btn btn-secondary-custom">
                    <i class="fas fa-users"></i> الفرق
                </a>
            </div>
        </div>

        <div class="profile-name">@displayName</div>
        @if (!string.IsNullOrEmpty(Model.Nickname) && Model.Nickname != Model.FriendName)
        {
            <div class="profile-real-name">@Model.FriendName</div>
        }

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <div class="profile-bio">@Model.Bio</div>
        }

        <div class="badges-row">
            @if (isMvp)
            {
                <span class="badge-item badge-mvp">👑 نجم المباراة</span>
            }
            @if (Model.PlayerRating.HasValue)
            {
                <span class="badge-item badge-rating">⭐ @Model.PlayerRating / 10</span>
            }
            @if (!string.IsNullOrEmpty(Model.PlayerPosition))
            {
                <span class="badge-item badge-position">@Model.PlayerPosition</span>
            }
            @if (!string.IsNullOrEmpty(Model.PlayerTag))
            {
                <span class="badge-item badge-tag">🏷️ @Model.PlayerTag</span>
            }
            <span class="badge-item" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);">
                @(Model.Status == "جاي أكيد" ? "✅" : Model.Status == "مش جاي" ? "❌" : "❓") @Model.Status
            </span>
        </div>

        <div class="profile-stats">
            <div class="stat-item">
                <div class="stat-value">@posts.Count()</div>
                <div class="stat-label">منشور</div>
            </div>
            @if (Model.PlayerRating.HasValue)
            {
                <div class="stat-item">
                    <div class="stat-value" style="color:#f59e0b;">@Model.PlayerRating⭐</div>
                    <div class="stat-label">التقييم</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.PlayerPosition))
            {
                <div class="stat-item">
                    <div class="stat-value" style="color:#a855f7;">@Model.PlayerPosition</div>
                    <div class="stat-label">المركز</div>
                </div>
            }
        </div>
    </div>

    <!-- Edit Panel (own profile) -->
    @if (isOwn)
    {
        <div class="edit-panel" id="editPanel" style="display:none;">
            <div class="edit-panel-title"><i class="fas fa-edit me-1"></i> تعديل بروفايلك</div>
            <input type="text" class="edit-input" id="editNickname" placeholder="الاسم المستعار (Nickname)" value="@Model.Nickname" maxlength="50" />
            <textarea class="edit-input" id="editBio" placeholder="بايو — اكتب حاجة عن نفسك..." maxlength="300" rows="3">@Model.Bio</textarea>
            <button class="save-btn" onclick="saveProfile()"><i class="fas fa-check me-1"></i> حفظ التغييرات</button>
        </div>
    }

    <!-- Admin Controls -->
    @if (isAdminUser && !isOwn)
    {
        <div class="admin-rating-panel">
            <span class="admin-rating-label"><i class="fas fa-star me-1"></i> تقييم الأدمن:</span>
            <input type="number" id="adminRatingInput" min="0" max="10" value="@(Model.PlayerRating ?? 0)"
                   style="width:70px;background:rgba(0,0,0,0.3);border:1px solid rgba(245,158,11,0.3);border-radius:6px;color:#f59e0b;padding:4px 8px;font-size:0.85rem;" />
            <button onclick="saveAdminRating()" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3);border-radius:6px;color:#f59e0b;padding:4px 12px;font-size:0.8rem;cursor:pointer;font-weight:700;">حفظ</button>
            <input type="text" id="adminTagInput" placeholder="تاج/لقب" value="@Model.PlayerTag"
                   style="flex:1;min-width:100px;background:rgba(0,0,0,0.3);border:1px solid rgba(245,158,11,0.3);border-radius:6px;color:#fff;padding:4px 8px;font-size:0.85rem;" />
            <button onclick="saveAdminTag()" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3);border-radius:6px;color:#f59e0b;padding:4px 12px;font-size:0.8rem;cursor:pointer;font-weight:700;">تاج</button>
        </div>
    }

    <!-- Posts -->
    <div class="posts-section">
        <div class="section-label">📝 منشورات @displayName</div>

        @if (!posts.Any())
        {
            <div style="text-align:center;color:rgba(255,255,255,0.25);padding:40px 20px;font-size:0.9rem;">
                لا توجد منشورات بعد
            </div>
        }

        @foreach (var post in posts)
        {
            <div class="post-card @(post.IsAdminPost ? "admin-post" : "")">
                @if (post.IsAdminPost)
                {
                    <div style="font-size:0.72rem;color:#f59e0b;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:4px;">
                        <i class="fas fa-crown"></i> منشور مميز
                    </div>
                }
                @if (!string.IsNullOrEmpty(post.Content))
                {
                    <div class="post-text">@post.Content</div>
                }
                @if (!string.IsNullOrEmpty(post.MediaPath))
                {
                    if (post.MediaType == "image")
                    {
                        <img src="@post.MediaPath" alt="صورة" onclick="openLightbox('@post.MediaPath')" style="cursor:pointer;" />
                    }
                    else
                    {
                        <video controls src="@post.MediaPath"></video>
                    }
                }
                <div class="post-meta">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                @if (post.Reactions.Any())
                {
                    <div class="post-reactions">
                        @foreach (var rg in post.Reactions.GroupBy(r => r.ReactionType))
                        {
                            <span class="reaction-chip">@rg.Key @rg.Count()</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" onclick="closeLightbox()">
        <button class="lightbox-close" onclick="closeLightbox(event)"><i class="fas fa-times"></i></button>
        <img id="lightboxImg" src="" alt="" onclick="event.stopPropagation()" />
    </div>

    <script>
        const profileId = @Model.Id;
        const currentUserId = @currentId;

        function showToast(msg) {
            const t = document.getElementById('toastMsg');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }

        function openLightbox(src) {
            document.getElementById('lightboxImg').src = src;
            document.getElementById('lightbox').classList.add('show');
        }

        function closeLightbox(e) {
            if (e) e.stopPropagation();
            document.getElementById('lightbox').classList.remove('show');
        }

        function toggleEditPanel() {
            const p = document.getElementById('editPanel');
            p.style.display = p.style.display === 'none' ? 'block' : 'none';
        }

        async function saveProfile() {
            const nickname = document.getElementById('editNickname')?.value || '';
            const bio = document.getElementById('editBio')?.value || '';

            const fd = new FormData();
            fd.append('nickname', nickname);
            fd.append('bio', bio);

            try {
                const res = await fetch('/Home/UpdateProfile', { method: 'POST', body: fd });
                const d = await res.json();
                if (d.success) {
                    showToast('تم حفظ التغييرات ✅');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(d.message || 'حصل خطأ');
                }
            } catch (err) {
                showToast('حصلت مشكلة في الاتصال');
            }
        }

        async function uploadCover(input) {
            if (!input.files || !input.files[0]) return;
            const fd = new FormData();
            fd.append('coverPhoto', input.files[0]);

            try {
                const res = await fetch('/Home/UpdateProfile', { method: 'POST', body: fd });
                const d = await res.json();
                if (d.success) {
                    showToast('تم تحديث الغلاف ✅');
                    setTimeout(() => location.reload(), 500);
                } else {
                    showToast(d.message || 'حصل خطأ');
                }
            } catch (err) {
                showToast('حصلت مشكلة');
            }
        }

        function sendMessage() {
            window.location.href = '/Home/Room?dm=' + profileId;
        }

        async function saveAdminRating() {
            const rating = parseInt(document.getElementById('adminRatingInput').value);
            if (isNaN(rating) || rating < 0 || rating > 10) { showToast('التقييم بين 0 و 10'); return; }

            const fd = new FormData();
            fd.append('attendanceId', profileId);
            fd.append('rating', rating);

            const res = await fetch('/Home/AdminSetRating', { method: 'POST', body: fd });
            const d = await res.json();
            if (d.success) { showToast(`تم حفظ التقييم ${d.rating} ⭐`); setTimeout(() => location.reload(), 600); }
            else showToast('حصل خطأ');
        }

        async function saveAdminTag() {
            const tag = document.getElementById('adminTagInput').value.trim();
            const fd = new FormData();
            fd.append('attendanceId', profileId);
            fd.append('tag', tag);

            const res = await fetch('/Home/AdminSetTag', { method: 'POST', body: fd });
            const d = await res.json();
            if (d.success) { showToast('تم حفظ التاج ✅'); setTimeout(() => location.reload(), 600); }
            else showToast('حصل خطأ');
        }
    </script>
</body>
</html>
