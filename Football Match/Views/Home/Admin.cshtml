@model IEnumerable<Football_Match.Models.Attendance>
@{
    Layout = null;
    var goingCount = Model.Count(m => m.Status == "جاي أكيد");
    var notGoingCount = Model.Count(m => m.Status == "مش جاي");
    var maybeCount = Model.Count(m => m.Status == "احتمال أجي");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>لوحة الأدمن</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: #0d0d1a; color: #fff; font-family: "Segoe UI", Tahoma, sans-serif; min-height: 100vh; padding: 24px; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
        .admin-header h2 { font-size: 1.4rem; font-weight: 800; }
        .stat-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 20px; text-align: center; }
        .stat-card h4 { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
        .stat-card h2 { font-size: 2.5rem; font-weight: 800; margin: 0; }
        .table-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 16px; overflow: hidden; }
        .table { color: #fff; margin: 0; }
        .table td { background-color: transparent !important; color: #fff !important; box-shadow: none !important; }
        .table th { background: rgba(255,255,255,0.05) !important; border-color: rgba(255,255,255,0.07); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.8px; color: rgba(255,255,255,0.5) !important; padding: 14px 16px; }
        .table td { border-color: rgba(255,255,255,0.05); padding: 12px 16px; vertical-align: middle; }
        .table tbody tr:hover { background: rgba(255,255,255,0.03); }
        .av-sm { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
        .av-sm-ph { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 700; }
        .badge-going { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; }
        .badge-notgoing { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; }
        .badge-maybe { background: rgba(245,158,11,0.15); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; }
        .del-form-btn { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; color: #ef4444; padding: 6px 12px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
        .del-form-btn:hover { background: rgba(239,68,68,0.2); }
        .logout-btn { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 10px; color: #ef4444; padding: 8px 18px; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
        .logout-btn:hover { color: #fff; background: #ef4444; }
        .room-link { background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.3); border-radius: 10px; color: #a855f7; padding: 8px 18px; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
        .room-link:hover { color: #fff; background: #7c3aed; }
        .note-text { color: rgba(255,255,255,0.4); font-size: 0.82rem; }
    </style>
</head>
<body>
    <div class="admin-header">
        <div>
            <h2><i class="fas fa-chart-bar me-2" style="color:#a855f7;"></i>لوحة الأدمن</h2>
            <div style="color:rgba(255,255,255,0.4);font-size:0.82rem;">@Model.Count() مسجّل إجمالاً</div>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
            <a asp-action="Room" class="room-link"><i class="fas fa-users me-1"></i>الغرفة</a>
            <a asp-action="Logout" class="logout-btn"><i class="fas fa-sign-out-alt me-1"></i>خروج</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card" style="border-color:rgba(34,197,94,0.2);">
                <h4 style="color:#22c55e;">جايين أكيد</h4>
                <h2 style="color:#22c55e;">@goingCount</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card" style="border-color:rgba(239,68,68,0.2);">
                <h4 style="color:#ef4444;">اعتذروا</h4>
                <h2 style="color:#ef4444;">@notGoingCount</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card" style="border-color:rgba(245,158,11,0.2);">
                <h4 style="color:#f59e0b;">احتمال</h4>
                <h2 style="color:#f59e0b;">@maybeCount</h2>
            </div>
        </div>
    </div>

    <div class="table-card">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الصورة</th>
                    <th>الاسم</th>
                    <th>رقم الموبايل</th>
                    <th>الحالة</th>
                    <th>ملاحظات</th>
                    <th>التاريخ</th>
                    <th class="text-center">إجراء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ProfilePicturePath))
                            {
                                <img class="av-sm" src="@item.ProfilePicturePath" alt="@item.FriendName" />
                            }
                            else
                            {
                                <div class="av-sm-ph" style="background:rgba(124,58,237,0.2);color:#a855f7;">
                                    @(item.FriendName.Length > 0 ? item.FriendName.Substring(0,1).ToUpper() : "?")
                                </div>
                            }
                        </td>
                        <td style="font-weight:600;">@item.FriendName</td>
                        <td style="color:rgba(255,255,255,0.5);font-size:0.87rem;">@item.PhoneNumber</td>
                        <td>
                            @if (item.Status == "جاي أكيد")
                            { <span class="badge-going">✅ جاي أكيد</span> }
                            else if (item.Status == "مش جاي")
                            { <span class="badge-notgoing">❌ مش جاي</span> }
                            else
                            { <span class="badge-maybe">❓ احتمال أجي</span> }
                        </td>
                        <td class="note-text">@(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)</td>
                        <td style="color:rgba(255,255,255,0.4);font-size:0.8rem;">
                            @((item.UpdatedAt ?? item.RespondedAt).ToString("g"))
                        </td>
                        <td class="text-center">
                            <form asp-action="Delete" method="post" onsubmit="return confirm('هل أنت متأكد من مسح هذه الإجابة؟');" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="del-form-btn"><i class="fas fa-trash me-1"></i>حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
