@model IEnumerable<Football_Match.Models.Attendance>
@{
    Layout = null;
    var goingCount = Model.Count(m => m.Status == "جاي أكيد");
    var notGoingCount = Model.Count(m => m.Status == "مش جاي");
    var maybeCount = Model.Count(m => m.Status == "احتمال أجي");
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>لوحة الحضور - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <style>
            body {
                background-color: #121212;
                color: #fff;
                font-family: sans-serif;
            }

            .card {
                background-color: #1e1e1e;
                border: 1px solid #333;
            }

            .table {
                color: #fff;
            }
    </style>
</head>
<body class="p-4">

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>📊 قائمة الحضور للماتش</h2>
            <a asp-action="Logout" class="btn btn-outline-danger btn-sm">تسجيل الخروج 🚪</a>
        </div>

        <!-- الإحصائيات -->
        <div class="row text-center mb-4">
            <div class="col-md-4">
                <div class="card p-3 border-success mb-2">
                    <h4 class="text-success">جايين أكيد</h4>
                    <h2>@goingCount</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 border-danger mb-2">
                    <h4 class="text-danger">اعتذروا</h4>
                    <h2>@notGoingCount</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 border-warning mb-2">
                    <h4 class="text-warning">احتمال</h4>
                    <h2>@maybeCount</h2>
                </div>
            </div>
        </div>

        <!-- الجدول -->
        <div class="card p-3">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>رقم الموبايل</th>
                        <th>الاسم</th>
                        <th>الحالة</th>
                        <th>ملاحظات</th>
                        <th>تاريخ الإجابة / التعديل</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-info fw-bold">@item.PhoneNumber</td>
                            <td class="fw-bold">@item.FriendName</td>
                            <td>
                                @if (item.Status == "جاي أكيد")
                                {
                                    <span class="badge bg-success">✅ جاي أكيد</span>
                                }
                                else if (item.Status == "مش جاي")
                                {

                                    <span class="badge bg-danger">❌ مش جاي</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">❓ احتمال أجي</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)</td>
                            <td>@item.RespondedAt.ToString("g")</td>
                            <td class="text-center">
                                <form asp-action="Delete" method="post" onsubmit="return confirm('هل أنت متأكد من مسح هذه الإجابة؟');" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">🗑️ حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>