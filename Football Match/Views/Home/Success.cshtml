@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تأكيد الإجابة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <style>
            body {
                background-color: #121212;
                color: #fff;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: sans-serif;
            }

            .card {
                background-color: #1e1e1e;
                border: 1px solid #333;
                max-width: 420px;
                width: 100%;
            }
    </style>
</head>
<body>

    <div class="card p-4 rounded-4 text-center shadow-lg">
        <div class="mb-3 display-3">✅</div>

        <!-- هنا بيظهر النص المتغير سواء تعديل أو تسجيل جديد -->
        <h3 class="fw-bold mb-3 text-white">@ViewBag.Message</h3>

        <p class="text-secondary small mb-4">تقدر ترجع في أي وقت وتعدل اختيارك بنفس رقم الموبايل.</p>

        <a asp-action="Index" class="btn btn-primary w-100 fw-bold py-2">الرجوع للصفحة الرئيسية 🏠</a>
    </div>

</body>
</html>