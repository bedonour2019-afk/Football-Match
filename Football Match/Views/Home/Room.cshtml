@model IEnumerable<Football_Match.Models.Attendance>
@{
    ViewData["Title"] = "غرفة الماتش والشات";
    var messages = ViewBag.Messages as List<Football_Match.Models.ChatMessage> ?? new List<Football_Match.Models.ChatMessage>();
    var currentAttendanceId = ViewBag.CurrentAttendanceId as int?;
    var myAttendance = Model.FirstOrDefault(a => a.Id == currentAttendanceId);
}

<input type="hidden" id="currentUserId" value="@currentAttendanceId" />

<div class="container-fluid py-3 min-vh-100 bg-dark text-white dir-rtl">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4 fw-bold">⚽ حجز الماتش والشات</span>
            <span class="badge bg-success rounded-pill px-3 py-2">مباشر</span>
        </div>
        <div>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light btn-sm rounded-pill">
                <i class="bi bi-arrow-right"></i> الرجوع للرئيسية
            </a>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="row g-3">
        <!-- القائمة الجانبية: تسجيل الحضور وتقسيمة الملعب -->
        <div class="col-lg-5 col-xl-4">
            <!-- كارت تسجيل موقفك -->
            <div class="card bg-secondary bg-opacity-25 text-white border-0 rounded-4 mb-3 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i>تسجيل موقفك من الماتش</h6>
                </div>
                <div class="card-body pt-1">
                    <form asp-action="SubmitAttendance" method="post" class="d-flex flex-column gap-2">
                        <input type="hidden" name="AttendanceId" value="@currentAttendanceId" />
                        <div>
                            <select name="Status" class="form-select bg-dark text-white border-secondary rounded-3">
                                <option value="جاي أكيد" selected="@(myAttendance?.Status == "جاي أكيد")">جاي أكيد ✅</option>
                                <option value="اعتذار" selected="@(myAttendance?.Status == "اعتذار")">اعتذار ❌</option>
                                <option value="محتمل" selected="@(myAttendance?.Status == "محتمل")">محتمل ❓</option>
                            </select>
                        </div>
                        <div>
                            <input type="text" name="Note" value="@myAttendance?.Note" class="form-control bg-dark text-white border-secondary rounded-3" placeholder="ملاحظة (مثلاً: متأخر 10 دقائق)..." />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-3 mt-1 fw-bold">تحديث الموقف</button>
                    </form>
                </div>
            </div>

            <!-- كارت تقسيمة الملعب (6 ضد 6) وقائمة الحضور -->
            <div class="card bg-secondary bg-opacity-25 text-white border-0 rounded-4 shadow-sm overflow-hidden">
                <div class="card-header bg-transparent border-0 pt-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-people-fill text-info me-2"></i>قائمة الحضور (@Model.Count(a => a.Status == "جاي أكيد"))</h6>
                    <ul class="nav nav-pills nav-sm bg-dark p-1 rounded-pill" id="attendanceTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active rounded-pill py-1 px-3 fs-7" id="pitch-tab" data-bs-toggle="tab" data-bs-target="#pitch-view" type="button">الملعب</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link rounded-pill py-1 px-3 fs-7" id="list-tab" data-bs-toggle="tab" data-bs-target="#list-view" type="button">القائمة</button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-2">
                    <div class="tab-content" id="attendanceTabContent">
                        <!-- عرض لوحة الملعب التقسيمة -->
                        <div class="tab-pane fade show active" id="pitch-view" role="tabpanel">
                            <div class="pitch-container rounded-4 p-3 position-relative bg-success bg-gradient border border-light border-opacity-25" style="min-height: 380px; background-image: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 20px 20px;">
                                <div class="text-center mb-2"><span class="badge bg-dark bg-opacity-75">الفريق الأول (6)</span></div>
                                <div class="row row-cols-3 g-2 text-center mb-4">
                                    @foreach (var player in Model.Where(a => a.Status == "جاي أكيد").Take(6))
                                    {
                                        <div class="col">
                                            <div class="p-1 rounded bg-dark bg-opacity-50 border border-success">
                                                <small class="d-block text-truncate fw-bold" style="max-width: 80px;">@player.FriendName</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <hr class="border-light opacity-50 my-2" />
                                <div class="text-center mb-2"><span class="badge bg-dark bg-opacity-75">الفريق الثاني (6)</span></div>
                                <div class="row row-cols-3 g-2 text-center">
                                    @foreach (var player in Model.Where(a => a.Status == "جاي أكيد").Skip(6).Take(6))
                                    {
                                        <div class="col">
                                            <div class="p-1 rounded bg-dark bg-opacity-50 border border-primary">
                                                <small class="d-block text-truncate fw-bold" style="max-width: 80px;">@player.FriendName</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- عرض القائمة العادية -->
                        <div class="tab-pane fade" id="list-view" role="tabpanel">
                            <div class="list-group list-group-flush" style="max-height: 380px; overflow-y: auto;">
                                @foreach (var item in Model)
                                {
                                    <div class="list-group-item bg-transparent text-white border-secondary d-flex align-items-center justify-content-between p-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(item.ProfilePicturePath) ? "/images/default-avatar.png" : item.ProfilePicturePath)" class="rounded-circle object-fit-cover" width="38" height="38" />
                                            <div>
                                                <div class="fw-bold fs-7">@item.FriendName</div>
                                                @if (!string.IsNullOrEmpty(item.Note))
                                                {
                                                    <small class="text-muted d-block fs-8">@item.Note</small>
                                                }
                                            </div>
                                        </div>
                                        <span class="badge @(item.Status == "جاي أكيد" ? "bg-success" : (item.Status == "اعتذار" ? "bg-danger" : "bg-warning")) fs-8">@item.Status</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- المنطقة الرئيسية: شات المجموعة -->
        <div class="col-lg-7 col-xl-8">
            <div class="card bg-secondary bg-opacity-25 text-white border-0 rounded-4 shadow-sm d-flex flex-column" style="height: 85vh;">
                <!-- شريط هيدر الشات -->
                <div class="card-header bg-transparent border-bottom border-secondary py-3 px-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-text-fill fs-5 text-primary"></i>
                        <h6 class="mb-0 fw-bold">شات المجموعة اللحظي</h6>
                    </div>
                    <small class="text-muted" id="connectionStatus"><i class="bi bi-circle-fill text-success fs-9"></i> متصل</small>
                </div>

                <!-- حاوية الرسائل -->
                <div class="card-body p-3 overflow-y-auto flex-grow-1" id="chatMessages" style="scroll-behavior: smooth;">
                    @foreach (var msg in messages)
                    {
                        var isMe = msg.AttendanceId == currentAttendanceId;
                        <div class="d-flex mb-3 @(isMe ? "justify-content-end" : "justify-content-start")" id="msg-@msg.Id">
                            @if (!isMe)
                            {
                                <img src="@(string.IsNullOrEmpty(msg.Sender?.ProfilePicturePath) ? "/images/default-avatar.png" : msg.Sender.ProfilePicturePath)"
                                     class="rounded-circle me-2 object-fit-cover align-self-end mb-1" width="32" height="32" />
                            }
                            <div class="message-bubble p-3 rounded-4 shadow-sm position-relative"
                                 style="max-width: 75%; @(isMe ? "background-color: #6f42c1; color: white;" : "background-color: #2b3035; color: white;")">

                                @if (!isMe)
                                {
                                    <small class="fw-bold d-block mb-1 text-info fs-8">@msg.Sender?.FriendName</small>
                                }

                                @if (!string.IsNullOrEmpty(msg.MediaPath))
                                {
                                    if (msg.MediaType == "image")
                                    {
                                        <img src="@msg.MediaPath" class="img-fluid rounded-3 mb-2 cursor-pointer" onclick="openGlobalLightbox('@msg.MediaPath')" style="max-height: 250px;" />
                                    }
                                    else if (msg.MediaType == "video")
                                    {
                                        <video src="@msg.MediaPath" controls class="w-100 rounded-3 mb-2" style="max-height: 250px;"></video>
                                    }
                                }

                                @if (!string.IsNullOrEmpty(msg.Content))
                                {
                                    <p class="mb-1 text-break fs-7" style="white-space: pre-line;">@msg.Content</p>
                                }

                                <div class="d-flex justify-content-between align-items-center mt-1 pt-1 border-top border-white border-opacity-10" style="font-size: 0.68rem; opacity: 0.75;">
                                    <span>@msg.SentAt.ToString("hh:mm tt")</span>
                                    @if (isMe)
                                    {
                                        <button class="btn btn-link btn-sm text-white p-0 ms-2 text-decoration-none" onclick="deleteMessage(@msg.Id)" title="حذف الرسالة">
                                            <i class="bi bi-trash fs-8"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- الفوتر ومربع أدوات الكتابة -->
                <div class="card-footer bg-transparent border-top border-secondary p-2">
                    <form id="chatForm" onsubmit="return false;" class="d-flex align-items-center gap-2">
                        <!-- زر رفع الميديا -->
                        <input type="file" id="mediaInput" accept="image/*,video/*" class="d-none" onchange="uploadSelectedMedia(this)" />
                        <button type="button" class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" onclick="document.getElementById('mediaInput').click()" title="إرفاق صورة أو فيديو">
                            <i class="bi bi-paperclip"></i>
                        </button>

                        <!-- حقل النص -->
                        <textarea id="messageInput" class="form-control bg-dark text-white border-secondary rounded-4 resize-none fs-7" rows="1" placeholder="اكتب رسالتك هنا..." oninput="autoResizeTextarea(this)"></textarea>

                        <!-- زر الإرسال -->
                        <button type="button" id="sendBtn" onclick="sendChatMessage()" class="btn btn-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- مكتبة SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // 1. إنشاء الاتصال
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .withAutomaticReconnect()
            .build();

        // 2. استقبال الرسائل الجدیدة
        connection.on("ReceiveMessage", function (msg) {
            const chatMessages = document.getElementById("chatMessages");
            if (!chatMessages) return;

            const currentUserId = document.getElementById("currentUserId").value;
            const isMe = msg.senderId == currentUserId;

            const msgDiv = document.createElement("div");
            msgDiv.className = `d-flex mb-3 ${isMe ? 'justify-content-end' : 'justify-content-start'}`;
            msgDiv.id = `msg-${msg.id}`;

            let mediaHTML = '';
            if (msg.mediaPath) {
                if (msg.mediaType === 'image') {
                    mediaHTML = `<img src="${msg.mediaPath}" class="img-fluid rounded-3 mb-2 cursor-pointer" onclick="openGlobalLightbox('${msg.mediaPath}')" style="max-height: 250px;" />`;
                } else if (msg.mediaType === 'video') {
                    mediaHTML = `<video src="${msg.mediaPath}" controls class="w-100 rounded-3 mb-2" style="max-height: 250px;"></video>`;
                }
            }

            msgDiv.innerHTML = `
                ${!isMe ? `<img src="${msg.senderPhoto || '/images/default-avatar.png'}" class="rounded-circle me-2 object-fit-cover align-self-end mb-1" width="32" height="32" />` : ''}
                <div class="message-bubble p-3 rounded-4 shadow-sm position-relative" style="max-width: 75%; ${isMe ? 'background-color: #6f42c1; color: white;' : 'background-color: #2b3035; color: white;'}">
                    ${!isMe ? `<small class="fw-bold d-block mb-1 text-info fs-8">${msg.senderName}</small>` : ''}
                    ${mediaHTML}
                    ${msg.content ? `<p class="mb-1 text-break fs-7" style="white-space: pre-line;">${msg.content}</p>` : ''}
                    <div class="d-flex justify-content-between align-items-center mt-1 pt-1 border-top border-white border-opacity-10" style="font-size: 0.68rem; opacity: 0.75;">
                        <span>${msg.sentAt}</span>
                        ${isMe ? `<button class="btn btn-link btn-sm text-white p-0 ms-2 text-decoration-none" onclick="deleteMessage(${msg.id})" title="حذف الرسالة"><i class="bi bi-trash fs-8"></i></button>` : ''}
                    </div>
                </div>
            `;

            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        });

        // 3. استقبال حذف الرسالة
        connection.on("MessageDeleted", function (messageId) {
            const el = document.getElementById(`msg-${messageId}`);
            if (el) el.remove();
        });

        // 4. بدء التشغيل
        connection.start()
            .then(() => {
                console.log("SignalR Connected Successfully!");
                document.getElementById("connectionStatus").innerHTML = `<i class="bi bi-circle-fill text-success fs-9"></i> متصل`;
            })
            .catch(err => {
                console.error("SignalR Connection Error:", err.toString());
                document.getElementById("connectionStatus").innerHTML = `<i class="bi bi-circle-fill text-danger fs-9"></i> غير متصل`;
            });

        // 5. دالة إرسال النص
        function sendChatMessage(mediaPath = null, mediaType = null) {
            const input = document.getElementById("messageInput");
            const content = input.value.trim();

            if (!content && !mediaPath) return;

            connection.invoke("SendMessage", content, mediaPath, mediaType)
                .then(() => {
                    input.value = "";
                    if (typeof autoResizeTextarea === 'function') autoResizeTextarea(input);
                })
                .catch(err => console.error("SendMessage Invoke Error:", err.toString()));
        }

        // 6. دالة حذف الرسالة
        function deleteMessage(messageId) {
            if (confirm("هل انت متاكد من حذف هذه الرسالة؟")) {
                connection.invoke("DeleteMessage", messageId)
                    .catch(err => console.error("DeleteMessage Error:", err.toString()));
            }
        }

        // 7. دالة رفع الصورة/الفيديو
        async function uploadSelectedMedia(inputEl) {
            if (!inputEl.files || inputEl.files.length === 0) return;

            const formData = new FormData();
            formData.append("file", inputEl.files[0]);

            try {
                const response = await fetch('/Home/UploadMedia', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (response.ok && data.path) {
                    sendChatMessage(data.path, data.type);
                    inputEl.value = "";
                } else {
                    alert(data.message || "حدث خطأ أثناء رفع الملف");
                }
            } catch (err) {
                console.error("Upload Error:", err);
            }
        }

        // 8. ضغطة Enter للإرسال
        document.getElementById("messageInput").addEventListener("keydown", function (e) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });

        // نزول الـ Scroll لأسفل القائمة تلقائياً عند تحميل الصفحة
        window.addEventListener("DOMContentLoaded", () => {
            const chatMessages = document.getElementById("chatMessages");
            if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
        });
    </script>
}