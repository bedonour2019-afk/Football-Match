@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🔐 دخول الأدمن - لوحة الإدارة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: linear-gradient(135deg, #090714 0%, #151035 50%, #0d0a1d 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, -apple-system, sans-serif;
            padding: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            width: 100%;
            max-width: 420px;
            padding: 38px 32px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #8b5cf6, #3b82f6, #ec4899);
        }

        .logo-area {
            text-align: center;
            margin-bottom: 28px;
        }

        .shield-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(59, 130, 246, 0.15));
            border: 1px solid rgba(139, 92, 246, 0.4);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #c4b5fd;
            margin-bottom: 12px;
            box-shadow: 0 0 25px rgba(139, 92, 246, 0.25);
        }

        .logo-area h3 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
        }

        .logo-area p {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.82rem;
        }

        .form-label-custom {
            color: rgba(255, 255, 255, 0.75);
            font-size: 0.84rem;
            font-weight: 600;
            margin-bottom: 7px;
            display: block;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.35);
            font-size: 0.95rem;
        }

        .form-control-custom {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            color: #fff;
            padding: 12px 42px 12px 16px;
            font-size: 0.92rem;
            outline: none;
            transition: all 0.2s;
        }

        .form-control-custom:focus {
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.08);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        .toggle-pw-btn {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.4);
            cursor: pointer;
            padding: 4px;
            font-size: 0.9rem;
            transition: color 0.15s;
        }
        .toggle-pw-btn:hover { color: #fff; }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            border: none;
            border-radius: 12px;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s;
            box-shadow: 0 4px 18px rgba(139, 92, 246, 0.35);
            margin-top: 6px;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.5);
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
        }

        .links-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .back-link {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.82rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color 0.2s;
        }
        .back-link:hover { color: #8b5cf6; }

        .alert-custom {
            background: rgba(239, 68, 68, 0.14);
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: #fca5a5;
            border-radius: 12px;
            padding: 11px 14px;
            margin-bottom: 20px;
            font-size: 0.86rem;
            display: flex;
            align-items: center;
            gap: 9px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-area">
            <div class="shield-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            <h3>تسجيل دخول الأدمن</h3>
            <p>لوحة التحكم وإدارة حضور الماتش</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-custom">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <label class="form-label-custom">اسم المستخدم</label>
            <div class="input-group-custom">
                <i class="fas fa-user input-icon"></i>
                <input type="text" name="username" class="form-control-custom" placeholder="اسم مستخدم الأدمن..." required autocomplete="username" autofocus />
            </div>

            <label class="form-label-custom">كلمة السر</label>
            <div class="input-group-custom">
                <i class="fas fa-lock input-icon"></i>
                <input type="password" id="adminPassword" name="password" class="form-control-custom" style="padding-left: 42px;" placeholder="كلمة سر الأدمن..." required autocomplete="current-password" />
                <button type="button" class="toggle-pw-btn" onclick="togglePassword()" title="إظهار/إخفاء">
                    <i class="fas fa-eye" id="pwToggleIcon"></i>
                </button>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fas fa-sign-in-alt me-2"></i> دخول للوحة الأدمن
            </button>
        </form>

        <div class="links-area">
            <a href="/" class="back-link">
                <i class="fas fa-arrow-right"></i> الرئيسية
            </a>
            <a href="/Home/Room" class="back-link">
                <i class="fas fa-comments"></i> غرفة الماتش
            </a>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById("adminPassword");
            const icon = document.getElementById("pwToggleIcon");
            if (input.type === "password") {
                input.type = "text";
                icon.className = "fas fa-eye-slash";
            } else {
                input.type = "password";
                icon.className = "fas fa-eye";
            }
        }
    </script>
</body>
</html>