@section Scripts {
    <!-- تضمين مكتبة SignalR لو مش موجودة عندك في المشروع -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. إنشاء الاتصال بالـ Hub (تأكد إن المسار /chatHub مطابق لـ Program.cs)
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            // 2. استقبال الرسائل الجديدة وعرضها في الـ DOM
            connection.on("ReceiveMessage", function (message) {
                console.log("رسالة جديدة:", message);
                
                const chatContainer = document.getElementById("chatMessagesContainer"); // حط الـ ID بتاع حاوية الرسائل عندك
                if (!chatContainer) return;

                const isMyMessage = message.senderId == document.getElementById("attendanceId").value;
                
                // تصميم شكل الرسالة (تدرجها حسب الكلاسات بتاعتك)
                const messageHtml = `
                    <div class="message-item ${isMyMessage ? 'user-message' : 'other-message'}" data-message-id="${message.id}">
                        <div class="d-flex align-items-center mb-1">
                            <img src="${message.senderPhoto || '/images/default-avatar.png'}" class="rounded-circle me-2" width="30" height="30" />
                            <strong>${message.senderName}</strong>
                            <small class="text-muted ms-2">${message.sentAt}</small>
                        </div>
                        <div class="message-body p-2 rounded bg-light">
                            ${message.content ? `<p class="mb-1">${message.content}</p>` : ''}
                            ${message.mediaPath ? `<img src="${message.mediaPath}" class="img-fluid rounded" style="max-height: 200px;" />` : ''}
                        </div>
                    </div>
                `;
                
                chatContainer.insertAdjacentHTML('beforeend', messageHtml);
                chatContainer.scrollTop = chatContainer.scrollHeight; // نزول تلقائي لآخر الرسائل
            });

            // 3. استقبال حدث حذف الرسالة
            connection.on("MessageDeleted", function (messageId) {
                const msgElement = document.querySelector(`[data-message-id="${messageId}"]`);
                if (msgElement) {
                    msgElement.remove();
                }
            });

            // 4. بدء الاتصال بالـ SignalR
            connection.start().then(function () {
                console.log("SignalR Connected Successfully!");
            }).catch(function (err) {
                console.error("SignalR Connection Failed: ", err.toString());
            });

            // 5. حدث الضغط على زر الإرسال
            const sendBtn = document.getElementById("sendButton");
            if (sendBtn) {
                sendBtn.addEventListener("click", function (e) {
                    e.preventDefault();

                    const attendanceId = parseInt(document.getElementById("attendanceId").value);
                    const contentInput = document.getElementById("messageInput");
                    const content = contentInput ? contentInput.value : "";

                    // لو حابب تضيف ميديا مستقبلاً، حددهم هنا
                    const mediaPath = null;
                    const mediaType = null;

                    if (!content.trim() && !mediaPath) return;

                    // استدعاء دالة SendMessage في الـ C# Hub بالظبط
                    connection.invoke("SendMessage", attendanceId, content, mediaPath, mediaType)
                        .then(() => {
                            if (contentInput) contentInput.value = ""; // تفريغ الحقل بعد الإرسال
                        })
                        .catch(function (err) {
                            console.error("Error invoking SendMessage:", err.toString());
                        });
                });
            }
        });
    </script>
}